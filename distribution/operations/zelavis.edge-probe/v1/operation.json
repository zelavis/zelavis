{
  "id": "zelavis.edge-probe",
  "version": "v1",
  "interpreter": "/bin/sh",
  "arguments": {
    "url": { "required": true, "maxLength": 1024 },
    "host": { "maxLength": 256 },
    "sni": { "maxLength": 256 },
    "expected-status": { "pattern": "^[1-5][0-9]{2}$", "maxLength": 3 },
    "timeout-ms": { "pattern": "^[0-9]+$", "maxLength": 8 }
  },
  "authorization": { "permission": "server.edge.manage", "scope": "system" },
  "result": { "format": "json", "maxBytes": 8192 }
}

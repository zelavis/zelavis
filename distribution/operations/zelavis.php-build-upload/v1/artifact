#!/bin/sh
# zelavis.php-build-upload v1 — sends one finished archive of a build to an address the caller presigned (a
# short-lived Cloudflare R2 URL), straight from the build's output, so the archive never passes through the
# Platform and no storage credential reaches this host. The address must be https on r2.cloudflarestorage.com
# (the manifest's pattern says so too). The result carries what was sent: the file's SHA-256 and size.
set -eu
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH LC_ALL=C

[ "$#" -eq 6 ] && [ "$1" = --file ] && [ "$3" = --job ] && [ "$5" = --url ] || { echo 'Expected --file, --job and --url.' >&2; exit 2; }
file=$2
job=$4
url=$6
case "$job" in *[!a-f0-9]*) echo 'Invalid job.' >&2; exit 2 ;; esac
[ "${#job}" -eq 16 ] || { echo 'Invalid job.' >&2; exit 2; }
case "$file" in */*|*..*|'') echo 'Invalid file.' >&2; exit 2 ;; esac
case "$url" in https://*.r2.cloudflarestorage.com/*) ;; *) echo 'The address must be an R2 address.' >&2; exit 2 ;; esac
case "$url" in *[!A-Za-z0-9._~:/?=\&+%-]*) echo 'The address has characters it may not.' >&2; exit 2 ;; esac
[ "$(id -u)" = 0 ] || { echo 'An upload needs the root operation Agent.' >&2; exit 2; }
command -v docker >/dev/null 2>&1 && command -v curl >/dev/null 2>&1 || { echo 'The container engine and curl are required.' >&2; exit 2; }
name="zv-phpbuild-$job"
[ "$(docker inspect --format '{{index .Config.Labels "zelavis.php-build"}}' "$name" 2>/dev/null)" = 1 ] || { echo 'No such build.' >&2; exit 1; }
[ "$(docker inspect --format '{{.State.Status}} {{.State.ExitCode}}' "$name")" = 'exited 0' ] || { echo 'The build has not finished successfully.' >&2; exit 1; }

dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT HUP INT TERM
docker cp "$name:/out/$file" - 2>/dev/null | tar -xf - -C "$dir" || { echo 'The build has no such archive.' >&2; exit 1; }
[ -f "$dir/$file" ] || { echo 'The build has no such archive.' >&2; exit 1; }
digest=$(sha256sum "$dir/$file" | cut -d ' ' -f 1)
bytes=$(wc -c < "$dir/$file" | tr -d ' ')
curl --fail --silent --show-error --proto '=https' --tlsv1.2 --max-time 780 \
  --header 'Content-Type: application/gzip' --header 'Cache-Control: public, max-age=86400' \
  --upload-file "$dir/$file" "$url" >/dev/null || { echo 'The upload was refused or failed.' >&2; exit 1; }
printf '{"schema":1,"file":"%s","sha256":"%s","bytes":%s}\n' "$file" "$digest" "$bytes"

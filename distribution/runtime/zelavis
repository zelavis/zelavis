#!/bin/sh
set -eu

# Resolve command/current links on both GNU and BSD hosts.
SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  TARGET=$(readlink "$SCRIPT_PATH")
  case "$TARGET" in /*) SCRIPT_PATH=$TARGET ;; *) SCRIPT_PATH="$(dirname "$SCRIPT_PATH")/$TARGET" ;; esac
done
ZELAVIS_HOME=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_PATH")/.." && pwd -P)
NODE="$ZELAVIS_HOME/runtime/node/bin/node"
if [ ! -x "$NODE" ]; then
  echo "Zelavis private Node runtime is missing. Reinstall the verified release." >&2
  exit 1
fi
NODE_MAJOR=$("$NODE" -p "Number(process.versions.node.split('.')[0])")
if [ "$NODE_MAJOR" -lt 24 ]; then
  echo "Zelavis requires private Node.js 24 or newer; found $("$NODE" --version)." >&2
  exit 1
fi
# User installations keep their data/token environment inside their prefix.
PREFIX=$(CDPATH= cd -- "$ZELAVIS_HOME/../.." && pwd -P)
if [ -f "$PREFIX/config/zelavis.env" ]; then
  exec "$NODE" --env-file="$PREFIX/config/zelavis.env" "$ZELAVIS_HOME/platform/dist/cli.js" "$@"
fi
exec "$NODE" "$ZELAVIS_HOME/platform/dist/cli.js" "$@"

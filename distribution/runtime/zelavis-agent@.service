[Unit]
Description=Zelavis Project Agent
Documentation=https://zelavis.com/docs
After=network-online.target
Before=zelavis@%i.service

[Service]
Type=simple
User=zelavis-%i
Group=zelavis-%i
WorkingDirectory=/var/lib/zelavis-%i
Environment=ZELAVIS_DATA_DIR=/var/lib/zelavis-%i
# Installed host operations use the separate root operations-only Agent.
# Keep Project workloads in this unit; no delegated operation controllers.
ExecStart=/opt/zelavis/instances/%i/current/bin/zelavis agent
KillMode=process
# Projects run in this unit and inherit this score, so under memory pressure the kernel picks a
# Project before the Platform (-500) and the operation Agent (-100). The Agent itself is small and
# so rarely chosen; if it is, its Projects survive (KillMode=process) and systemd restarts it.
OOMScoreAdjust=200
TimeoutStopSec=95
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
# Project temporary storage must outlive this Agent's mount namespace.

[Install]
WantedBy=multi-user.target

[Unit]
Description=Zelavis Project Agent
Documentation=https://zelavis.com/docs
After=network-online.target
Before=zelavis.service

[Service]
Type=simple
User=zelavis
Group=zelavis
WorkingDirectory=/var/lib/zelavis
Environment=ZELAVIS_DATA_DIR=/var/lib/zelavis
# Installed host operations use the separate root operations-only Agent.
# Keep Project workloads in this unit; no delegated operation controllers.
ExecStart=/opt/zelavis/current/bin/zelavis agent
KillMode=process
TimeoutStopSec=95
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

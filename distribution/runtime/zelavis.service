[Unit]
Description=Zelavis Platform OS
After=network-online.target zelavis.socket
Wants=network-online.target
# systemd owns the listening socket across restarts; see zelavis.socket.
Requires=zelavis.socket

[Service]
Type=simple
User=zelavis
Group=zelavis
WorkingDirectory=/var/lib/zelavis
Environment=ZELAVIS_DATA_DIR=/var/lib/zelavis
EnvironmentFile=-/etc/zelavis/zelavis.env
ExecStart=/opt/zelavis/current/bin/zelavis serve --host 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

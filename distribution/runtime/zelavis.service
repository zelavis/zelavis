[Unit]
Description=Zelavis Platform OS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zelavis
Group=zelavis
WorkingDirectory=/var/lib/zelavis
Environment=ZELAVIS_DATA_DIR=/var/lib/zelavis
ExecStart=/opt/zelavis/current/bin/zelavis serve --host 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=Zelavis Edge (Traefik)
After=network-online.target zelavis.service
Wants=network-online.target zelavis.service

[Service]
Type=simple
User=zelavis
Group=zelavis
ExecStart=/opt/zelavis/current/edge/traefik/traefik --configFile=/etc/zelavis/edge/traefik/traefik.yml
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/zelavis/edge/traefik
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

{
  "name": "zelavis-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Zelavis workspace for the self-hostable App Platform.",
  "main": "index.js",
  "packageManager": "pnpm@11.4.0+sha512.f0febc7e37552ab485494a914241b338e0b3580b93d54ce31f00933015880863129038a1b4ae4e414a0ee63ac35bf21197e990172c4a68256450b5636310968f",
  "scripts": {
    "audit:security": "pnpm audit --audit-level=moderate --ignore GHSA-rmmr-r34h-pfm5",
    "audit:security:full": "pnpm audit --audit-level=low",
    "build": "pnpm -r --filter './packages/*' --filter './plugins/*' --filter './plugins/*/adapters/*' --filter './plugins/*/plugins/*' --filter './packages/*/adapters/*' --filter './packages/*/plugins/*' --if-present build",
    "build:sdk": "pnpm --filter zelavis build:sdk",
    "build:sdk:browser": "pnpm --filter zelavis build:sdk:browser",
    "build:sdk:node": "pnpm --filter zelavis build:sdk:node",
    "check": "pnpm run typecheck",
    "ci:runtime": "pnpm --filter @zelavis/server build && pnpm --filter @zelavis/app build && pnpm --filter @zelavis/app-db-node-sqlite build && pnpm --filter @zelavis/app-db-bun-sqlite build && pnpm --filter @zelavis/ecommerce build && pnpm check && pnpm --filter zelavis test",
    "ci:ui": "pnpm --filter @zelavis/ui typecheck && ZELAVIS_E2E_PROJECT_ID=dashboard-e2e ZELAVIS_UI_BASE_PATH=/zelavis/ pnpm --filter @zelavis/ui exec playwright test --project=desktop --grep @smoke",
    "changeset": "changeset",
    "changeset:add": "node scripts/create-changeset.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "clean:db": "node scripts/clean-databases.mjs",
    "plugin:ecommerce:build": "pnpm --filter @zelavis/ecommerce build",
    "example:plugin-basic:build": "pnpm install --filter @zelavis/example-plugin-basic && pnpm --filter @zelavis/example-plugin-basic build",
    "example:plugin-basic:package": "pnpm install --filter @zelavis/example-plugin-basic && pnpm --filter @zelavis/example-plugin-basic package",
    "example:plugin-basic:specifier": "pnpm install --filter @zelavis/example-plugin-basic && pnpm --filter @zelavis/example-plugin-basic specifier",
    "example:bun": "pnpm --filter @zelavis/example-bun dev",
    "example:nextjs": "pnpm --filter @zelavis/example-nextjs dev",
    "example:nodejs": "pnpm --filter @zelavis/example-nodejs dev",
    "example:web-fetch": "pnpm --filter @zelavis/example-web-fetch typecheck",
    "release:check": "pnpm typecheck && pnpm test && pnpm build",
    "release:status": "changeset status --verbose",
    "release:version": "node scripts/release-version.mjs stable",
    "release:version:alpha": "node scripts/release-version.mjs alpha",
    "release:pre:exit": "changeset pre exit",
    "release:publish:alpha": "node scripts/release-publish.mjs alpha",
    "release:publish:latest": "node scripts/release-publish.mjs latest",
    "dev": "node scripts/dev.mjs",
    "distribution:stage": "node distribution/scripts/build-stage.mjs",
    "distribution:archives": "node distribution/scripts/build-archives.mjs",
    "distribution:deb": "node distribution/scripts/build-deb.mjs",
    "distribution:apt": "sh distribution/scripts/build-apt-repository.sh",
    "distribution:repository-package": "node distribution/scripts/build-repository-package.mjs",
    "distribution:checksums": "node distribution/scripts/build-checksums.mjs",
    "distribution:test": "node --test distribution/test/*.test.mjs",
    "distribution:build": "sh distribution/scripts/build-all.sh",
    "website:dev": "pnpm --filter @zelavis/website dev",
    "website:typecheck": "pnpm --filter @zelavis/website typecheck",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "keywords": [],
  "author": "Ivan Jeremic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.0",
    "get-port": "^7.2.0",
    "zelavis": "workspace:*"
  }
}

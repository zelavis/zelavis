{
  "name": "zelavis-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "A collection of low-level utilities and libraries for building modern applications.",
  "main": "index.js",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm run typecheck",
    "example:cloudflare": "pnpm build && pnpm --filter @zelavis/example-cloudflare dev",
    "example:elysia": "pnpm build && pnpm --filter @zelavis/example-elysia dev",
    "example:express": "pnpm build && pnpm --filter @zelavis/example-express dev",
    "example:fastify": "pnpm build && pnpm --filter @zelavis/example-fastify dev",
    "example:h3": "pnpm build && pnpm --filter @zelavis/example-h3 dev",
    "example:hono": "pnpm build && pnpm --filter @zelavis/example-hono dev",
    "example:nextjs": "pnpm build && pnpm --filter @zelavis/example-nextjs dev",
    "example:nodejs": "pnpm build && pnpm --filter @zelavis/example-nodejs dev",
    "example:web-fetch": "pnpm --filter @zelavis/example-web-fetch typecheck",
    "ui:dev": "node scripts/ui-dev.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "zelavis": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}

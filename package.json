{
  "name": "zelavis-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Zelavis workspace for the composable backend platform.",
  "main": "index.js",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "audit:security": "pnpm audit --audit-level=moderate --ignore GHSA-rmmr-r34h-pfm5",
    "audit:security:full": "pnpm audit --audit-level=low",
    "build": "pnpm -r --filter './packages/*' --filter './plugins/*' --filter './plugins/*/adapters/*' --filter './plugins/*/plugins/*' --filter './packages/*/adapters/*' --filter './packages/*/plugins/*' --if-present build",
    "check": "pnpm run typecheck",
    "ci:runtime": "pnpm --filter @zelavis/server build && pnpm --filter @zelavis/ecommerce build && pnpm --filter @zelavis/auth build && pnpm --filter @zelavis/database build && pnpm check && pnpm --filter zelavis test",
    "ci:ui": "pnpm --filter @zelavis/ui typecheck && ZELAVIS_UI_BASE_PATH=/zelavis/ pnpm --filter @zelavis/ui exec playwright test --project=desktop",
    "changeset": "changeset",
    "changeset:add": "node scripts/create-changeset.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "example:cloudflare": "pnpm --filter @zelavis/example-cloudflare dev",
    "example:bun": "pnpm --filter @zelavis/example-bun dev",
    "example:elysia": "pnpm --filter @zelavis/example-elysia dev",
    "example:express": "pnpm --filter @zelavis/example-express dev",
    "example:fastify": "pnpm --filter @zelavis/example-fastify dev",
    "example:h3": "pnpm --filter @zelavis/example-h3 dev",
    "example:hono": "pnpm --filter @zelavis/example-hono dev",
    "example:netlify": "pnpm --filter @zelavis/example-netlify typecheck",
    "example:nextjs": "pnpm --filter @zelavis/example-nextjs dev",
    "example:nextjs-pages-router": "pnpm --filter @zelavis/example-nextjs-pages-router dev",
    "example:nodejs": "pnpm --filter @zelavis/example-nodejs dev",
    "example:vercel": "pnpm --filter @zelavis/example-vercel typecheck",
    "example:web-fetch": "pnpm --filter @zelavis/example-web-fetch typecheck",
    "release:check": "pnpm typecheck && pnpm test && pnpm build",
    "release:status": "changeset status --verbose",
    "release:version": "node scripts/release-version.mjs stable",
    "release:version:alpha": "node scripts/release-version.mjs alpha",
    "release:pre:exit": "changeset pre exit",
    "release:publish:alpha": "node scripts/release-publish.mjs alpha",
    "release:publish:latest": "node scripts/release-publish.mjs latest",
    "ui:dev": "node scripts/ui-dev.mjs",
    "website:dev": "pnpm --filter @zelavis/website dev",
    "website:typecheck": "pnpm --filter @zelavis/website typecheck",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "keywords": [],
  "author": "Ivan Jeremic",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "type": "commonjs",
  "devDependencies": {
    "@changesets/changelog-git": "^0.2.1",
    "@changesets/cli": "^2.31.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "get-port": "^7.2.0",
    "zelavis": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "axios": "^1.15.2",
      "fast-uri": "3.1.2",
      "follow-redirects": "^1.16.0",
      "hono": "^4.12.18",
      "ip-address": "10.1.1",
      "path-to-regexp": "^8.4.0",
      "postcss": "^8.5.10",
      "react": "19.2.5",
      "react-dom": "19.2.5"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "lightningcss"
    ],
    "auditConfig": {
      "ignoreCves": [
        "GHSA-rmmr-r34h-pfm5"
      ]
    }
  }
}

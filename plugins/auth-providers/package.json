{
  "name": "@zelavis/auth-providers",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Identity provider definitions for @zelavis/auth: Google, GitHub, and generic OIDC.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "plugin",
    "capabilities": [
      "@zelavis/auth:oauth"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "plugins/auth-providers"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/plugins/auth-providers#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "@zelavis/auth": ">=1.0.1-alpha.2",
    "zelavis": ">=1.0.1-alpha.2"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "zelavis": "workspace:*",
    "@zelavis/auth": "workspace:*"
  },
  "keywords": [
    "auth",
    "oauth",
    "oidc",
    "google",
    "github"
  ]
}

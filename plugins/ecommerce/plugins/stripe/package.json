{
  "name": "@zelavis/ecommerce-stripe",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "Stripe payment provider service for @zelavis/ecommerce.",
  "author": "Ivan Jeremic",
  "license": "MIT",
  "type": "module",
  "zelavis": {
    "kind": "plugin",
    "capabilities": [
      "@zelavis/ecommerce:payments"
    ]
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "plugins/ecommerce/plugins/stripe"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/plugins/ecommerce/plugins/stripe#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/ecommerce": "workspace:*",
    "stripe": "^22.6.0"
  },
  "peerDependencies": {
    "zelavis": ">=1.0.1-alpha.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "stripe",
    "commerce",
    "ecommerce",
    "payments",
    "service"
  ]
}

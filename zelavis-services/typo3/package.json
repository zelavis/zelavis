            "label": "Database port",
            "value": "{ports.db}"
          },
          {
            "id": "db-name",
            "label": "Database name",
            "value": "typo3"
          },
          {
            "id": "db-user",
            "label": "Database user",
            "value": "typo3"
          },
          {

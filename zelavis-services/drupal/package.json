            "name": "web",
            "protocol": "http"
          },
          {
            "name": "db",
            "protocol": "tcp"
          }
        ],
        "directories": [
          {
            "name": "site",
            "path": "site"
          },
          {
            "name": "db",
            "path": "db"
          }
        ],
        "setup": [
          {
            "id": "db-type",
            "label": "Database type",
            "value": "MySQL, MariaDB, Percona Server, or equivalent"
          },
          {
            "id": "db-name",
            "label": "Database name",
            "value": "drupal"
          },
          {
            "id": "db-user",
            "label": "Database user",
            "value": "drupal"
          },
          {
            "id": "db-password",
            "label": "Database password",
            "value": "{secret.db-password}"
          },
          {
            "id": "db-host",
            "label": "Database host (Advanced options)",
            "value": "127.0.0.1"
          },
          {
            "id": "db-port",
            "label": "Database port (Advanced options)",
            "value": "{ports.db}"
          }
        ]

    "effect": "4.0.0",
    "zelavis": ">=2.0.0-alpha.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },

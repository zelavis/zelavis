{
  "name": "@zelavis/joomla",
  "version": "5.4.9-alpha.0",
  "private": false,
  "description": "Official Zelavis Joomla Project recipe: a native site with dedicated Nginx, PHP-FPM and MariaDB.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "app",
    "namespace": "joomla",
    "capabilities": [
      "app:project",
      "app:managed",
      "app:joomla"
    ],
    "project": {
      "runtimeKinds": [
        "native"
      ],
      "runtime": "./dist/runtime.js",
      "managed": {
        "adminTitle": "Joomla Administrator",
        "adminPath": "/administrator/"
      },
      "hostPackages": [
        "php-stack",
        "mariadb-server"
      ],
      "install": {
        "contract": 1,
        "methods": [
          {
            "id": "native",
            "driver": "js",
            "entry": "./dist/recipe.js",
            "requires": [
              "nginx",
              "php-fpm",
              "mariadb"
            ]
          }
        ],
        "software": [
          {
            "version": "5.4.9",
            "archive": "https://github.com/joomla/joomla-cms/releases/download/5.4.9/Joomla_5.4.9-Stable-Full_Package.tar.gz",
            "sha256": "8c658d16b6e908f8cfce3556ac7280fe210c4ebd916202f406fe6bf1b5b05149",
            "maxBytes": 67108864
          }
        ],
        "ports": [
          {
            "name": "web",
            "protocol": "http"
          },
          {
            "name": "db",
            "protocol": "tcp"
          }
        ],
        "directories": [
          {
            "name": "site",
            "path": "site"
          },
          {
            "name": "db",
            "path": "db"
          }
        ],
        "setup": [
          {
            "id": "db-type",
            "label": "Database type",
            "value": "MySQLi"
          },
          {
            "id": "db-host",
            "label": "Database host",
            "value": "127.0.0.1:{ports.db}"
          },
          {
            "id": "db-name",
            "label": "Database name",
            "value": "joomla"
          },
          {
            "id": "db-user",
            "label": "Database user",
            "value": "joomla"
          },
          {
            "id": "db-password",
            "label": "Database password",
            "value": "{secret.db-password}"
          }
        ]
      }
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "zelavis-services/joomla"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/zelavis-services/joomla#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "effect": "4.0.0",
    "zelavis": ">=2.0.0-alpha.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "zelavis",
    "joomla",
    "cms",
    "recipe"
  ]
}

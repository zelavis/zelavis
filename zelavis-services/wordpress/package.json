{
  "name": "@zelavis/wordpress",
  "version": "7.1.3-alpha.2",
  "private": false,
  "description": "Official Zelavis WordPress Project recipe: a native site with dedicated Nginx, PHP-FPM and MariaDB.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "app",
    "namespace": "wordpress",
    "capabilities": [
      "app:project",
      "app:managed",
      "app:wordpress"
    ],
    "project": {
      "runtimeKinds": [
        "native"
      ],
      "runtime": "./dist/runtime.js",
      "managed": {
        "adminTitle": "WordPress Admin",
        "adminPath": "/wp-admin/"
      },
      "hostPackages": [
        "php-stack",
        "mariadb-server"
      ],
      "install": {
        "contract": 1,
        "methods": [
          {
            "id": "native",
            "driver": "js",
            "entry": "./dist/recipe.js",
            "requires": [
              "nginx",
              "php-fpm",
              "mariadb"
            ]
          }
        ],
        "software": [
          {
            "version": "7.1.2",
            "archive": "https://wordpress.org/wordpress-7.1.2.tar.gz",
            "sha256": "c0c666689d66b870d8825500bb8e402ed04de52602c61a6f516c6236b8c9ac67",
            "maxBytes": 67108864
          }
        ],
        "ports": [
          {
            "name": "web",
            "protocol": "http"
          },
          {
            "name": "db",
            "protocol": "tcp"
          }
        ],
        "adopt": [
          {
            "state": "wordpress-native.json",
            "move": {
              "wordpress": "site",
              "mariadb": "db"
            },
            "ports": {
              "web": "httpPort",
              "db": "databasePort"
            },
            "secrets": {
              "db-password": "databasePassword"
            },
            "socketId": "socketId",
            "marks": [
              "db/.zelavis-initialized"
            ],
            "discard": [
              "nginx.conf",
              "php-fpm.conf",
              "nginx.pid",
              "php-fpm.pid",
              "mariadb.pid",
              "nginx-access.log",
              "nginx-error.log",
              "php-fpm.log",
              "php-errors.log",
              "mariadb.log",
              "tmp",
              "sessions",
              "nginx-client-temp",
              "nginx-proxy-temp",
              "nginx-fastcgi-temp",
              "nginx-uwsgi-temp",
              "nginx-scgi-temp"
            ]
          }
        ],
        "directories": [
          {
            "name": "site",
            "path": "site"
          },
          {
            "name": "db",
            "path": "db"
          }
        ]
      }
    },
    "marketplace": {
      "title": "WordPress",
      "summary": "A native managed WordPress site with dedicated Nginx, PHP-FPM, and MariaDB instances.",
      "categories": [
        "apps",
        "cms",
        "official"
      ],
      "tags": [
        "wordpress",
        "cms",
        "php",
        "mariadb",
        "native"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\"",
    "update:wordpress": "node scripts/update-wordpress-release.mjs",
    "check:provisioning": "node scripts/check-wordpress-provisioning.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "zelavis-services/wordpress"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/zelavis-services/wordpress#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "effect": "4.0.0",
    "zelavis": ">=2.0.0-alpha.16"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "effect": "4.0.0",
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "zelavis",
    "wordpress",
    "cms",
    "recipe"
  ]
}

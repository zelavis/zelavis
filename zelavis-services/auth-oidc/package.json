{
  "name": "@zelavis/app-auth-oidc",
  "version": "2.0.0-alpha.4",
  "private": false,
  "description": "OIDC/JWKS bearer authentication plugin for Zelavis.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "plugin",
    "capabilities": [
      "zelavis/identity:credentials"
    ],
    "namespace": "oidc",
    "marketplace": {
      "title": "OpenID Connect Sign-in",
      "summary": "Let people sign in with any OpenID Connect provider, or verify bearer tokens from one.",
      "categories": [
        "auth",
        "identity",
        "official"
      ],
      "tags": [
        "oidc",
        "jwks",
        "sso"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "zelavis-services/auth-oidc"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/zelavis-services/auth-oidc#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "zelavis": ">=2.0.0-alpha.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "auth",
    "oauth",
    "oidc",
    "jwt",
    "jwks"
  ]
}

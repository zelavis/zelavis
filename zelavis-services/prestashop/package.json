        "ports": [
          {
            "name": "web",
            "protocol": "http"
          },
          {
            "name": "db",
            "protocol": "tcp"
          }
        ],
        "directories": [
          {
            "name": "site",
            "path": "site"
          },
          {
            "name": "db",
            "path": "db"
          }
        ],
        "setup": [
          {
            "id": "db-server",
            "label": "Database server",
            "value": "127.0.0.1:{ports.db}"
          },
          {
            "id": "db-name",
            "label": "Database name",
            "value": "prestashop"
          },
          {
            "id": "db-user",
            "label": "Database user",
            "value": "prestashop"
          },
          {
            "id": "db-password",
            "label": "Database password",
            "value": "{secret.db-password}"
          },
          {
            "id": "db-prefix",
            "label": "Tables prefix",
            "value": "ps_"
          }
        ]

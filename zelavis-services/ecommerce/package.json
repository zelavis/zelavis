{
  "name": "@zelavis/ecommerce",
  "version": "2.0.0-alpha.3",
  "private": false,
  "description": "Official Zelavis ecommerce plugin with runtime APIs, commerce domain APIs, and payment provider integrations.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "plugin",
    "capabilities": [
      "api:routes",
      "dashboard:menu"
    ],
    "namespace": "ecommerce"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dashboard",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "zelavis-services/ecommerce"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/zelavis-services/ecommerce#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "effect": "4.0.0-rc.117"
  },
  "peerDependencies": {
    "zelavis": ">=2.0.0-alpha.4"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "zelavis",
    "plugin",
    "ecommerce",
    "marketplace",
    "payments",
    "subscriptions",
    "commerce"
  ]
}

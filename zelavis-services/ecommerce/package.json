{
  "name": "@zelavis/ecommerce",
  "version": "2.0.0-alpha.4",
  "private": false,
  "description": "Official Zelavis ecommerce plugin with runtime APIs, commerce domain APIs, and payment provider integrations.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "plugin",
    "capabilities": [
      "api:routes",
      "dashboard:menu"
    ],
    "namespace": "ecommerce",
    "marketplace": {
      "title": "Ecommerce",
      "summary": "Products, orders, customers, coupons and subscriptions, with payment providers you choose.",
      "categories": [
        "commerce",
        "official"
      ],
      "tags": [
        "shop",
        "store",
        "payments"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dashboard",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "zelavis-services/ecommerce"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/zelavis-services/ecommerce#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "zelavis": ">=2.0.0-alpha.4",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "effect": "4.0.0",
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "zelavis",
    "plugin",
    "ecommerce",
    "marketplace",
    "payments",
    "subscriptions",
    "commerce"
  ]
}

{
  "name": "@zelavis/ecommerce-stripe",
  "version": "1.0.0-alpha.3",
  "private": false,
  "description": "Stripe payment provider service for @zelavis/ecommerce.",
  "author": "Ivan Jeremic",
  "license": "MIT",
  "type": "module",
  "zelavis": {
    "kind": "plugin",
    "capabilities": [
      "@zelavis/ecommerce:payments"
    ],
    "namespace": "stripe",
    "marketplace": {
      "title": "Stripe Payments",
      "summary": "Take card payments in Ecommerce through Stripe.",
      "categories": [
        "commerce",
        "payments",
        "official"
      ],
      "tags": [
        "stripe",
        "cards"
      ]
    }
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && esbuild src/index.ts --bundle --format=esm --platform=node --target=node24 --external:zelavis --external:'zelavis/*' --external:effect --external:'effect/*' --banner:js=\"import { createRequire as __zelavisCreateRequire } from 'node:module'; const require = __zelavisCreateRequire(import.meta.url);\" --outfile=dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "zelavis-services/ecommerce/plugins/stripe"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/zelavis-services/ecommerce/plugins/stripe#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "zelavis": ">=2.0.0-alpha.5",
    "@zelavis/ecommerce": ">=2.0.0-alpha.4"
  },
  "devDependencies": {
    "@zelavis/ecommerce": "workspace:*",
    "esbuild": "^0.28.2",
    "stripe": "^22.6.2",
    "typescript": "^7.0.2",
    "zelavis": "workspace:*"
  },
  "keywords": [
    "stripe",
    "commerce",
    "ecommerce",
    "payments",
    "service"
  ]
}

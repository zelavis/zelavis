{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@zelavis/ecommerce": [
        "../../plugins/ecommerce/src/index.ts"
      ],
      "@zelavis/ecommerce-paypal": [
        "../../plugins/ecommerce/plugins/paypal/src/index.ts"
      ],
      "@zelavis/ecommerce-stripe": [
        "../../plugins/ecommerce/plugins/stripe/src/index.ts"
      ],
      "zelavis": [
        "../../packages/zelavis/src/index.ts"
      ],
      "zelavis/app/auth": [
        "../../packages/zelavis/src/app/auth/index.ts"
      ],
      "zelavis/runtime": [
        "../../packages/zelavis/src/core/runtime/index.ts"
      ],
      "zelavis/adapters/bun": [
        "../../packages/zelavis/src/adapters/bun.ts"
      ],
      "zelavis/dbnew": [
        "../../packages/zelavis/src/dbnew/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [

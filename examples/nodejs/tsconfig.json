{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "baseUrl": "../..",
    "typeRoots": ["packages/server/node_modules/@types", "node_modules/@types"],
    "paths": {
      "@zelavis/auth": ["packages/auth/src/index.ts"],
      "@zelavis/database": ["packages/database/src/index.ts"],
      "@zelavis/database-node-sqlite": [
        "packages/database/adapters/node-sqlite/src/index.ts"
      ],
      "@zelavis/ecommerce": ["packages/ecommerce/src/index.ts"],
      "@zelavis/ecommerce-paypal": [
        "packages/ecommerce/plugins/paypal/src/index.ts"
      ],
      "@zelavis/ecommerce-stripe": [
        "packages/ecommerce/plugins/stripe/src/index.ts"
      ],
      "@zelavis/server": ["packages/server/src/index.ts"],
      "@zelavis/server/adapters/express": [
        "packages/server/src/adapters/express.ts"
      ],
      "@zelavis/server/adapters/node": [
        "packages/server/src/adapters/node.ts"
      ],
      "zelavis": ["packages/zelavis/src/index.ts"],
      "zelavis/adapters/express": [
        "packages/zelavis/src/adapters/express.ts"
      ],
      "zelavis/adapters/hono": [
        "packages/zelavis/src/adapters/hono.ts"
      ],
      "zelavis/adapters/node": ["packages/zelavis/src/adapters/node.ts"]
    }
  },
  "include": ["index.ts"]
}

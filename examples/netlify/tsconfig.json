{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "zelavis": [
        "packages/zelavis/src/index.ts"
      ],
      "zelavis/adapters/netlify": [
        "packages/zelavis/src/adapters/netlify.ts"
      ]
    }
  },
  "include": [
    "**/*.ts"
  ]
}

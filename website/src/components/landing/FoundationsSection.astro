---
const foundations = [
	{
		number: '01',
		title: 'Platform OS',
		tagline: 'Control plane & fleet supervision',
		description: 'Long-running process orchestrator, project registry, server management, System Store, and Project Gateway.',
		href: '/packages/zelavis',
	},
	{
		number: '02',
		title: 'Multi-Model DB',
		tagline: 'Event-sourced object engine',
		description: 'Write once through documents API; project through document, column, measure, and graph lenses with swappable key-value storage.',
		href: '/api/database',
	},
	{
		number: '03',
		title: 'Service Runtime',
		tagline: 'Typed capabilities & contributions',
		description: 'Contracts, plugins, background workloads, endpoint-backed capabilities, and headless frontends loaded from static manifests.',
		href: '/architecture/service-model',
	},
];
---

<!-- Brand Band CTA -->
<section class="amp-brand-band" data-local-content>
	<div class="amp-wrap" data-reveal>
		<p class="amp-eyebrow">Yours, all the way down</p>
		<h2>Managed when you want it.<br />Self-hosted when you need it.</h2>
		<p>Keep the exact same developer and application model across your local workstation, a private VPS, and a multi-region distributed fleet.</p>
		<div class="brand-band-actions">
			<a class="amp-button amp-button-dark" href="/getting-started/installation">
				<span>Install Zelavis</span>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
					<path d="M5 12h14M12 5l7 7-7 7" />
				</svg>
			</a>
			<a class="amp-button amp-button-ghost" href="/pricing">View Managed Cloud Plans</a>
		</div>
	</div>
</section>

<!-- Dark Foundations Section -->
<section class="amp-dark amp-products" data-local-content>
	<div class="amp-wrap">
		<div class="amp-heading centered" data-reveal>
			<p class="amp-eyebrow">Build with the whole platform</p>
			<h2>Pair the App stack with these core foundations.</h2>
			<p>Every primitive is built to be independent, composable, and replaceable whenever you outgrow default conventions.</p>
		</div>

		<div class="product-cards" data-reveal>
			{foundations.map((item) => (
				<a href={item.href} class="product-card">
					<div class="card-header">
						<span class="card-num">{item.number}</span>
						<span class="card-arrow">→</span>
					</div>
					<h3>{item.title}</h3>
					<span class="card-tagline">{item.tagline}</span>
					<p>{item.description}</p>
				</a>
			))}
		</div>
	</div>
</section>

<style>
	/* Brand Band */
	.amp-brand-band {
		padding: 130px 0;
		background:
			radial-gradient(circle at 82% 18%, rgba(255, 163, 143, 0.72), transparent 32%),
			linear-gradient(120deg, #dfe9ff 0%, #e8e3ff 50%, #fce6e8 100%);
		text-align: center;
	}

	.amp-wrap {
		width: min(1180px, calc(100% - 64px));
		margin: 0 auto;
	}

	.amp-brand-band .amp-wrap {
		max-width: 860px;
	}

	.amp-eyebrow {
		margin: 0 0 14px;
		font-size: 13px;
		line-height: 1.2;
		font-weight: 750;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #5846cf;
	}

	.amp-brand-band h2 {
		margin: 0;
		font-size: clamp(40px, 5.5vw, 68px);
		line-height: 1.08;
		letter-spacing: -0.04em;
		font-weight: 750;
		color: #121422;
	}

	.amp-brand-band p:not(.amp-eyebrow) {
		max-width: 640px;
		margin: 22px auto 34px;
		color: #5d6170;
		font-size: 18px;
		line-height: 1.6;
	}

	.brand-band-actions {
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
		gap: 14px;
	}

	.amp-button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		min-height: 52px;
		padding: 0 28px;
		border-radius: 999px;
		text-decoration: none;
		font-size: 15px;
		font-weight: 700;
		transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
	}

	.amp-button:hover {
		transform: translateY(-2px);
	}

	.amp-button-dark {
		background: #111218;
		color: #fff;
		box-shadow: 0 10px 24px rgba(17, 18, 24, 0.2);
	}

	.amp-button-dark:hover {
		background: #20222e;
	}

	.amp-button-ghost {
		background: rgba(255, 255, 255, 0.6);
		color: #242738;
		border: 1px solid rgba(0, 0, 0, 0.1);
	}

	.amp-button-ghost:hover {
		background: #fff;
	}

	/* Dark Section */
	.amp-dark {
		background: #0d0e14;
		color: #f7f7f9;
	}

	.amp-products {
		padding: 130px 0 110px;
	}

	.amp-dark .amp-eyebrow {
		color: #a49aff;
	}

	.amp-dark .amp-heading h2 {
		color: #fff;
		font-size: clamp(38px, 4.8vw, 56px);
		letter-spacing: -0.035em;
		font-weight: 750;
		margin: 0;
	}

	.amp-dark .amp-heading > p:last-child {
		color: #9295a6;
		max-width: 660px;
		margin: 18px auto 0;
		font-size: 17px;
		line-height: 1.6;
	}

	.amp-heading.centered {
		text-align: center;
		margin-bottom: 56px;
	}

	.product-cards {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 20px;
	}

	.product-card {
		position: relative;
		min-height: 280px;
		padding: 32px 28px;
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 20px;
		background: #141620;
		color: #fff;
		text-decoration: none;
		display: flex;
		flex-direction: column;
		transition: transform 0.25s ease, background 0.25s ease, border-color 0.25s ease;
	}

	.product-card:hover {
		transform: translateY(-6px);
		background: #1a1c2a;
		border-color: rgba(142, 127, 255, 0.35);
		box-shadow: 0 16px 36px rgba(0, 0, 0, 0.35);
	}

	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 40px;
	}

	.card-num {
		font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		color: #797d92;
		font-size: 12px;
		font-weight: 700;
	}

	.card-arrow {
		font-size: 18px;
		color: #797d92;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	.product-card:hover .card-arrow {
		color: #a49aff;
		transform: translateX(4px);
	}

	.product-card h3 {
		margin: 0;
		font-size: 24px;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.card-tagline {
		display: block;
		font-size: 12px;
		color: #a49aff;
		font-weight: 600;
		margin: 6px 0 12px;
	}

	.product-card p {
		margin: 0;
		color: #9a9db0;
		font-size: 14.5px;
		line-height: 1.6;
	}

	@media (max-width: 960px) {
		.product-cards {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.amp-brand-band {
			padding: 80px 0;
		}

		.amp-products {
			padding: 80px 0;
		}

		.brand-band-actions {
			flex-direction: column;
		}

		.brand-band-actions .amp-button {
			width: 100%;
		}
	}
</style>

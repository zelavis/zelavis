---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import SegmentedControl from '../components/SegmentedControl.astro';
import StickyLocalNav from '../components/StickyLocalNav.astro';
import BrandMarquee from '../components/BrandMarquee.astro';

const platformTabs = [
	{ id: 'apps', label: 'Apps', title: 'Projects that start production-ready', body: 'Create isolated projects with their runtime, version, services, and data boundary already defined.' },
	{ id: 'data', label: 'Data', title: 'One object, many useful lenses', body: 'Write once through the documents API and query document, column, measure, and graph projections.' },
	{ id: 'workloads', label: 'Workloads', title: 'Code that lives beside the product', body: 'Run project-scoped functions, jobs, schedules, and webhooks in the long-running Zelavis runtime.' },
	{ id: 'hosting', label: 'Hosting', title: 'Your server is a first-class target', body: 'Host websites on infrastructure you control, with domains, logs, backups, and lifecycle operations in one place.' },
	{ id: 'content', label: 'Content', title: 'Structured content without another system', body: 'Model content types, entries, schemas, and media on top of the same tenant-aware data foundation.' },
];

const capabilities = [
	{ number: '01', label: 'Database', title: 'Sharded from the first project', body: 'Every official Zelavis App routes stable virtual ranges across physical shards—even when they all live on one node.', accent: 'blue' },
	{ number: '02', label: 'Platform Fabric', title: 'Placement is authority, not a URL', body: 'The control plane owns nodes, allocation, routing, generations, and lifecycle while project runtimes stay isolated.', accent: 'violet' },
	{ number: '03', label: 'Open surfaces', title: 'Use the dashboard—or do not', body: 'Stable endpoints and SDK boundaries keep every capability available to CLIs, agents, scripts, plugins, and your own tools.', accent: 'coral' },
];

const faqs = [
	{ question: 'What does Zelavis replace?', answer: 'Zelavis combines the platform responsibilities teams often split across a backend service, CMS, hosting panel, database administration tool, and workloads platform. You can adopt the complete product or embed its focused packages.' },
	{ question: 'Can I run it on my own infrastructure?', answer: 'Yes. Self-hosting is a foundation of the product, not an export path. Native website hosting targets user-controlled infrastructure, while managed providers remain optional adapters.' },
	{ question: 'Is Zelavis tied to SQLite?', answer: 'No. The database store runs over an ordered key-value boundary. SQLite is the default, while libSQL, RocksDB, and LMDB engines are available behind the same logical database APIs.' },
	{ question: 'Does one server still use the sharded architecture?', answer: 'Yes. Official Zelavis Apps use the topology router from creation. On a small installation the shard placements simply share one node, so scaling out changes placement instead of changing the application model.' },
	{ question: 'Which parts are available today?', answer: 'Core runtime, project isolation, the multi-model database, auth foundations, workloads, dashboard, and local hosting capabilities are implemented. Collaboration and some fleet-scale operations remain explicit roadmap work.' },
];
---

<MarketingLayout
	title="Zelavis — The App Platform"
	description="Plan, build, and manage apps together. Auth, database, content, workloads, and hosting in one self-hostable platform."
>
	<StickyLocalNav showAfterId="platform" items={[
		{ id: 'platform', label: 'Platform' },
		{ id: 'data', label: 'Data' },
		{ id: 'architecture', label: 'Architecture' },
		{ id: 'hosting', label: 'Hosting' },
		{ id: 'questions', label: 'Questions' },
	]} />
	<section class="amp-hero">
		<div class="amp-orb amp-orb-one" aria-hidden="true"></div>
		<div class="amp-orb amp-orb-two" aria-hidden="true"></div>
		<div class="amp-hero-inner">
			<div class="amp-hero-copy">
				<p class="amp-kicker" data-reveal>The Agentic App Platform</p>
				<h1 data-reveal style="--delay: 70">Plan. Build. Manage.<br />Own every layer.</h1>
				<p class="amp-hero-lede" data-reveal style="--delay: 140">
					Auth, data, content, workloads, and native hosting—one self-hostable platform
					for the whole product.
				</p>
				<div class="amp-actions" data-reveal style="--delay: 210">
					<a class="amp-button amp-button-light" href="/getting-started/installation">Start building</a>
					<a class="amp-button amp-button-outline" href="/docs">Read the docs</a>
				</div>
			</div>

			<div class="amp-product-stage" aria-label="Zelavis project overview" data-reveal style="--delay: 180">
				<div class="stage-glow"></div>
				<div class="stage-window">
					<div class="stage-topbar">
						<span class="stage-logo">Z</span>
						<span>northstar / production</span>
						<span class="stage-status"><i></i> healthy</span>
					</div>
					<div class="stage-body">
						<aside>
							<b>Overview</b><span>Database</span><span>Auth</span><span>Content</span><span>Workloads</span>
						</aside>
						<div class="stage-canvas">
							<p>Project activity</p>
							<div class="stage-chart" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
							<div class="stage-metrics"><span><b>4</b> shards</span><span><b>12</b> services</span><span><b>99.99%</b> healthy</span></div>
						</div>
					</div>
				</div>
				<div class="stage-float stage-float-top"><span>Deploy complete</span><b>v1.0.4</b><i>✓</i></div>
				<div class="stage-float stage-float-bottom"><span>Database</span><b>4 shards · SQLite</b><i>→</i></div>
			</div>
		</div>
		<div class="hero-brand-dock"><BrandMarquee /></div>
	</section>

	<section class="amp-section amp-platform" id="platform" data-local-content>
		<div class="amp-wrap">
			<div class="amp-heading centered platform-heading" data-reveal>
				<p class="amp-eyebrow">One platform, end to end</p>
			</div>

			<div class="amp-tabs-wrap" data-reveal>
				<SegmentedControl
					id="platform-tabs"
					label="Platform capabilities"
					value="apps"
					width="540px"
					options={platformTabs.map((tab) => ({ value: tab.id, label: tab.label }))}
				/>
			</div>

			<div class="amp-platform-panel" data-reveal>
				<div class="platform-visual">
					<div class="visual-shell">
						<div class="visual-toolbar"><i></i><i></i><i></i><span>zelavis://northstar</span></div>
						<div class="visual-content">
							<div class="visual-list"><b>Projects</b><span class="active">Northstar</span><span>Atlas</span><span>Studio</span></div>
							<div class="visual-board">
								<div class="visual-board-head"><span>Northstar</span><small>Running</small></div>
								<div class="visual-cards"><i></i><i></i><i></i></div>
								<div class="visual-lines"><i></i><i></i><i></i><i></i></div>
							</div>
						</div>
					</div>
				</div>
				<div class="platform-copy">
					<p class="amp-eyebrow" data-panel-label>Apps</p>
					<h3 data-panel-title>{platformTabs[0].title}</h3>
					<p data-panel-body>{platformTabs[0].body}</p>
					<a href="/architecture/project-model">Explore the architecture <span>→</span></a>
				</div>
			</div>
		</div>
	</section>

	<section class="amp-section amp-soft" id="data" data-local-content>
		<div class="amp-wrap">
			<div class="amp-heading centered" data-reveal>
				<p class="amp-eyebrow">Data without the seams</p>
				<h2>One write. Many ways to understand it.</h2>
				<p>The event log is the source of truth. Document, column, measure, and graph lenses stay close enough to intersect without moving data between engines.</p>
			</div>
			<div class="lens-stage" data-reveal>
				<div class="lens-source"><span>01</span><b>Document write</b><code>tenant.documents.put()</code></div>
				<div class="lens-line" aria-hidden="true"></div>
				<div class="lens-event"><span>Event log</span><b>append → project</b></div>
				<div class="lens-grid">
					<article><i>◫</i><b>Document</b><span>Objects and fields</span></article>
					<article><i>▥</i><b>Column</b><span>Fast intersections</span></article>
					<article><i>⌁</i><b>Measure</b><span>Time-series signals</span></article>
					<article><i>⌘</i><b>Graph</b><span>Connected records</span></article>
				</div>
			</div>
		</div>
	</section>

	<section class="amp-section amp-statement" data-local-content>
		<div class="amp-wrap narrow" data-reveal>
			<p class="amp-eyebrow">Fewer seams. Clearer ownership.</p>
			<h2>Your app should not feel like five vendors sitting next to each other.</h2>
			<p>Zelavis gives every project one boundary for its runtime, data, services, version, and lifecycle—without giving up the option to replace the pieces underneath.</p>
		</div>
	</section>

	<section class="amp-proof" data-local-content>
		<div class="amp-wrap proof-inner" data-reveal>
			<div class="proof-mark">Z</div>
			<blockquote>“The platform shell is a client of Zelavis—not the place where Zelavis happens.”</blockquote>
			<p>Every dashboard action maps to a stable endpoint and capability, so the same system remains open to agents, CLIs, scripts, and your own frontend.</p>
		</div>
	</section>

	<section class="amp-section amp-together" id="architecture" data-local-content>
		<div class="amp-wrap">
			<div class="amp-heading centered" data-reveal>
				<p class="amp-eyebrow">Better together</p>
				<h2>One platform. Clean boundaries.</h2>
				<p>The control plane and project runtimes work as one product without sharing one failure domain.</p>
			</div>
			<div class="together-grid">
				<div class="together-copy">
					{capabilities.map((item, index) => (
						<button class:list={['together-item', index === 0 && 'active']} type="button" data-capability={item.accent}>
							<span>{item.number}</span><div><b>{item.label}</b><p>{item.title}</p></div><i>+</i>
						</button>
					))}
				</div>
				<div class="together-visual" data-accent="blue" data-reveal>
					<div class="topology-head"><span>App data topology</span><b>version 18</b></div>
					<div class="topology-map">
						<div class="topology-node root"><span>Project</span><b>northstar</b></div>
						<div class="topology-links"></div>
						<div class="topology-shards">
							<div><span>Shard 01</span><b>0000–3fff</b></div><div><span>Shard 02</span><b>4000–7fff</b></div><div><span>Shard 03</span><b>8000–bfff</b></div><div><span>Shard 04</span><b>c000–ffff</b></div>
						</div>
					</div>
					<p data-capability-description>{capabilities[0].body}</p>
				</div>
			</div>
		</div>
	</section>

	<section class="amp-section amp-features" id="hosting" data-local-content>
		<div class="amp-wrap">
			<article class="feature-row" data-reveal>
				<div><p class="amp-eyebrow">Run anywhere</p><h2>Start on one machine.<br />Keep the architecture.</h2><p>Small installations and larger fleets use the same topology. Scaling changes placement and replicas—not your application API.</p></div>
				<div class="feature-visual servers"><i></i><i></i><i></i><span>one logical platform</span></div>
			</article>
			<article class="feature-row reverse" data-reveal>
				<div><p class="amp-eyebrow">Explicit authority</p><h2>A child knows its parent.<br />It never becomes it.</h2><p>Projects receive scoped resources and services while the Platform Fabric retains node, placement, generation, and fleet authority.</p></div>
				<div class="feature-visual authority"><span>Platform Fabric</span><div><i>Project A</i><i>Project B</i><i>Project C</i></div></div>
			</article>
			<article class="feature-row" data-reveal>
				<div><p class="amp-eyebrow">Extensible by design</p><h2>Plugins contribute.<br />Contracts decide.</h2><p>Ordinary services extend validated, namespaced capabilities. Trusted platform services own the schemas and privileged boundaries.</p></div>
				<div class="feature-visual plugins"><b>zelavis/core</b><span>auth</span><span>payments</span><span>storage</span><span>frontend</span></div>
			</article>
		</div>
	</section>

	<section class="amp-brand-band" data-local-content>
		<div class="amp-wrap" data-reveal>
			<p class="amp-eyebrow">Yours, all the way down</p>
			<h2>Managed when you want it.<br />Self-hosted when you need it.</h2>
			<p>Keep the same product model across a laptop, a private server, and a distributed fleet.</p>
			<a class="amp-button amp-button-dark" href="/getting-started/installation">Install Zelavis</a>
		</div>
	</section>

	<section class="amp-dark amp-products" data-local-content>
		<div class="amp-wrap">
			<div class="amp-heading centered" data-reveal>
				<p class="amp-eyebrow">Build with the whole platform</p>
				<h2>Pair the App stack with these Zelavis foundations.</h2>
			</div>
			<div class="product-cards">
				<a href="/packages/zelavis"><span>01</span><h3>Platform OS</h3><p>Projects, servers, lifecycle, gateway, and the System Store.</p><i>→</i></a>
				<a href="/api/database"><span>02</span><h3>Multi-model DB</h3><p>Event-sourced objects with document, column, measure, and graph lenses.</p><i>→</i></a>
				<a href="/architecture/service-model"><span>03</span><h3>Service runtime</h3><p>Typed capabilities, endpoints, contributions, plugins, and frontends.</p><i>→</i></a>
			</div>
		</div>
	</section>

	<section class="amp-dark amp-faq" id="questions" data-local-content>
		<div class="amp-wrap faq-wrap">
			<h2 data-reveal>Frequently asked questions</h2>
			<div class="faq-list" data-reveal>
				{faqs.map((faq, index) => (
					<details open={index === 0}>
						<summary>{faq.question}<span></span></summary>
						<p>{faq.answer}</p>
					</details>
				))}
			</div>
		</div>
	</section>

	<script id="platform-tab-data" type="application/json" set:html={JSON.stringify(platformTabs)}></script>
	<script id="capability-data" type="application/json" set:html={JSON.stringify(capabilities)}></script>
	<script is:inline>
		(function () {
			var tabControl = document.getElementById('platform-tabs');
			var data = JSON.parse(document.getElementById('platform-tab-data').textContent || '[]');
			var label = document.querySelector('[data-panel-label]');
			var title = document.querySelector('[data-panel-title]');
			var body = document.querySelector('[data-panel-body]');
			var panelCopy = document.querySelector('.platform-copy');

			function updatePanel(selected) {
				function setContent() {
					label.textContent = selected.label;
					title.textContent = selected.title;
					body.textContent = selected.body;
				}
				if (!panelCopy || !panelCopy.animate || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
					setContent();
					return;
				}
				panelCopy.getAnimations().forEach(function (animation) { animation.cancel(); });
				var out = panelCopy.animate(
					[{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-7px)' }],
					{ duration: 120, easing: 'ease-in', fill: 'forwards' }
				);
				out.onfinish = function () {
					setContent();
					panelCopy.animate(
						[{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'translateY(0)' }],
						{ duration: 240, easing: 'cubic-bezier(.16,1,.3,1)', fill: 'both' }
					);
				};
			}

			function selectTab(value) {
				var selected = data.find(function (item) { return item.id === value; });
				if (!selected) return;
				updatePanel(selected);
			}

			if (tabControl) tabControl.addEventListener('segmented-change', function (event) {
				selectTab(event.detail.value);
			});
			var capabilityData = JSON.parse(document.getElementById('capability-data').textContent || '[]');
			var capabilityButtons = Array.from(document.querySelectorAll('[data-capability]'));
			var visual = document.querySelector('.together-visual');
			var description = document.querySelector('[data-capability-description]');
			capabilityButtons.forEach(function (button, index) {
				button.addEventListener('click', function () {
					capabilityButtons.forEach(function (item) { item.classList.toggle('active', item === button); });
					visual.dataset.accent = button.dataset.capability; description.textContent = capabilityData[index].body;
				});
			});
		})();
	</script>

	<style>
		:global(body) { background: #fff; color: #12131a; }
		:global(.nav) { position: absolute; top: 0; width: 100%; background: transparent; border: 0; color: white; z-index: 20; }
		:global(.nav.is-stuck) { position: fixed; background: transparent; border-color: transparent; -webkit-backdrop-filter: none; backdrop-filter: none; }
		:global(.nav .nav-inner) { max-width: 1220px; }
		:global(.nav .nav-links), :global(.nav .nav-actions) { font-family: var(--font); font-size: 16px; font-weight: 500; letter-spacing: -.04px; }
		:global(.nav .nav-links a), :global(.nav .nav-links button), :global(.nav .nav-login), :global(.nav .brand), :global(.nav .brand-word) { color: white; }
		:global(.nav .nav-cta) { background: white; color: #17181c; box-shadow: none; }
		.amp-wrap, .amp-hero-inner { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
		.amp-hero { position: relative; height: 100vh; height: 100svh; height: 100dvh; min-height: 0; display: grid; grid-template-rows: minmax(0, 1fr) auto; overflow: hidden; color: #fff; border-radius: 0 0 34px 34px; background: radial-gradient(circle at 87% 28%, rgba(251, 131, 130, .72), transparent 32%), radial-gradient(circle at 50% 105%, rgba(76, 36, 149, .86), transparent 38%), linear-gradient(118deg, #153b96 0%, #263a9d 34%, #6844ac 69%, #a95d82 100%); font-family: var(--font); }
		.amp-orb { position: absolute; border-radius: 999px; filter: blur(2px); opacity: .3; pointer-events: none; }.amp-orb-one { width: 620px; height: 620px; right: -260px; top: 20px; background: radial-gradient(circle, #ffa475, transparent 68%); }.amp-orb-two { width: 520px; height: 520px; left: 27%; bottom: -330px; background: radial-gradient(circle, #5d25bb, transparent 70%); }
		.amp-hero-inner { position: relative; z-index: 2; min-height: 0; padding: clamp(92px, 14dvh, 112px) 0 clamp(12px, 3dvh, 24px); display: grid; grid-template-columns: .96fr 1.04fr; gap: clamp(30px, 4vw, 56px); align-items: center; overflow: hidden; }
		.hero-brand-dock { position: relative; z-index: 4; min-width: 0; }
		.amp-kicker { margin: 0 0 8px; font-size: clamp(18px, 2.8dvh, 22px); line-height: 1.1; font-weight: 500; letter-spacing: normal; text-transform: none; }.amp-eyebrow { margin: 0 0 18px; font-size: 14px; line-height: 1.2; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }.amp-hero h1 { max-width: 660px; margin: 0; font-size: clamp(42px, 8dvh, 64px); line-height: 1.09; letter-spacing: -1px; font-weight: 700; }.amp-hero-lede { max-width: 590px; margin: clamp(16px, 3.75dvh, 30px) 0 0; font-size: clamp(16px, 2.25dvh, 18px); line-height: 1.34; font-weight: 400; letter-spacing: normal; color: rgba(255,255,255,.88); }.amp-actions { display: flex; gap: 14px; margin-top: clamp(18px, 4.25dvh, 34px); }
		.amp-button { display: inline-flex; align-items: center; justify-content: center; min-height: 54px; padding: 0 25px; border-radius: 999px; text-decoration: none; font-weight: 700; transition: transform .25s ease, background .25s ease; }.amp-button:hover { transform: translateY(-2px); }.amp-button-light { background: #fff; color: #14151a; }.amp-button-outline { border: 1px solid rgba(255,255,255,.65); color: #fff; }.amp-button-dark { background: #111218; color: #fff; }
		.amp-product-stage { position: relative; min-height: clamp(270px, 54dvh, 490px); display: grid; place-items: center; perspective: 900px; }.stage-glow { position: absolute; inset: 8% 2%; border-radius: 50%; background: rgba(255,255,255,.28); filter: blur(70px); }.stage-window { position: relative; width: 100%; border: 1px solid rgba(255,255,255,.3); border-radius: 16px; overflow: hidden; background: rgba(247,249,255,.96); color: #1b1d28; box-shadow: 0 40px 80px rgba(15,16,69,.35); transform: rotateY(-5deg) rotateX(2deg); }.stage-topbar { height: clamp(44px, 6.75dvh, 54px); padding: 0 17px; display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #e7e8ef; font-size: 12px; color: #696b78; }.stage-logo { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 8px; background: #28259d; color: white; font-weight: 800; }.stage-status { margin-left: auto; display: flex; align-items: center; gap: 6px; padding: 6px 9px; border-radius: 999px; background: #eaf7ef; color: #27834b; }.stage-status i { width: 6px; height: 6px; border-radius: 50%; background: #42b46c; }
		.stage-body { min-height: clamp(220px, 40dvh, 320px); display: grid; grid-template-columns: 118px 1fr; }.stage-body aside { padding: clamp(16px, 3dvh, 24px) 16px; display: flex; flex-direction: column; gap: clamp(10px, 2.1dvh, 17px); border-right: 1px solid #e7e8ef; background: #f5f6fb; font-size: 11px; color: #8a8c99; }.stage-body aside b { padding: 8px; margin: -8px; border-radius: 7px; background: #e6e7f6; color: #25277c; }.stage-canvas { padding: clamp(17px, 3.5dvh, 28px); }.stage-canvas > p { margin: 0 0 clamp(12px, 3dvh, 24px); font-size: 14px; font-weight: 700; }.stage-chart { height: clamp(92px, 18.75dvh, 150px); display: flex; gap: 13px; align-items: end; padding: clamp(11px, 2.25dvh, 18px); border: 1px solid #e8e9ef; border-radius: 12px; background: #fff; }.stage-chart i { flex: 1; height: var(--h); border-radius: 5px 5px 2px 2px; background: linear-gradient(#7c72e8, #4138b2); }.stage-chart i:nth-child(1){--h:38%}.stage-chart i:nth-child(2){--h:55%}.stage-chart i:nth-child(3){--h:46%}.stage-chart i:nth-child(4){--h:77%}.stage-chart i:nth-child(5){--h:64%}.stage-chart i:nth-child(6){--h:88%}.stage-chart i:nth-child(7){--h:95%}.stage-metrics { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; margin-top: 12px; }.stage-metrics span { padding: clamp(7px, 1.4dvh, 11px); border-radius: 9px; background: #f1f2f7; font-size: 9px; color: #777a86; }.stage-metrics b { display: block; font-size: 15px; color: #20222a; }
		.stage-float { position: absolute; z-index: 3; width: 220px; padding: 14px 44px 14px 16px; border: 1px solid rgba(255,255,255,.5); border-radius: 12px; background: #fff; color: #21232d; box-shadow: 0 20px 45px rgba(26,20,88,.24); }.stage-float span { display: block; font-size: 10px; color: #858795; }.stage-float b { font-size: 13px; }.stage-float i { position: absolute; right: 14px; top: 20px; width: 25px; height: 25px; display: grid; place-items: center; border-radius: 50%; background: #e9f7ef; color: #279456; font-style: normal; }.stage-float-top { right: -28px; top: 52px; }.stage-float-bottom { left: -26px; bottom: 38px; }
		.amp-section { padding: 128px 0; }.amp-heading { max-width: 790px; margin-bottom: 58px; }.amp-heading.centered { margin-left: auto; margin-right: auto; text-align: center; }.amp-eyebrow { color: #6253d7; }.amp-heading h2, .amp-statement h2, .amp-brand-band h2, .feature-row h2 { margin: 0; font-size: clamp(42px, 5vw, 66px); line-height: 1.04; letter-spacing: -.045em; font-weight: 650; }.amp-heading > p:last-child:not(.amp-eyebrow), .amp-statement .narrow > p:last-child { max-width: 700px; margin: 22px auto 0; font-size: 18px; line-height: 1.65; color: #666974; }
		.platform-heading { margin-bottom: 28px; }

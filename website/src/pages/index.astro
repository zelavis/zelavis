---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import StickyLocalNav from '../components/StickyLocalNav.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import PlatformSection from '../components/landing/PlatformSection.astro';
import DataSection from '../components/landing/DataSection.astro';
import ArchitectureSection from '../components/landing/ArchitectureSection.astro';
import FeatureSection from '../components/landing/FeatureSection.astro';
import FoundationsSection from '../components/landing/FoundationsSection.astro';
import FaqSection from '../components/landing/FaqSection.astro';
---

<MarketingLayout
	title="Zelavis — The App Platform"
	description="Plan, build, and manage apps together. Auth, database, content, workloads, and hosting in one self-hostable platform."
>
	<StickyLocalNav
		showAfterId="platform"
		items={[
			{ id: 'platform', label: 'Platform' },
			{ id: 'data', label: 'Data' },
			{ id: 'architecture', label: 'Architecture' },
			{ id: 'hosting', label: 'Hosting' },
			{ id: 'questions', label: 'Questions' },
		]}
	/>

	<HeroSection />
	<PlatformSection />
	<DataSection />
	<ArchitectureSection />
	<FeatureSection />
	<FoundationsSection />
	<FaqSection />

	<style>
		:global(body) {
			background: #fff;
			color: #12131a;
		}

		:global(.nav) {
			position: absolute;
			top: 0;
			width: 100%;
			background: transparent;
			border: 0;
			color: white;
			z-index: 20;
		}

		:global(.nav.is-stuck) {
			position: fixed;
			background: transparent;
			border-color: transparent;
			-webkit-backdrop-filter: none;
			backdrop-filter: none;
		}

		:global(.nav .nav-inner) {
			max-width: 1220px;
		}

		:global(.nav .nav-links),
		:global(.nav .nav-actions) {
			font-family: var(--font, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
			font-size: 16px;
			font-weight: 500;
			letter-spacing: -0.04px;
		}

		:global(.nav .nav-links a),
		:global(.nav .nav-links button),
		:global(.nav .nav-login),
		:global(.nav .brand),
		:global(.nav .brand-word) {
			color: white;
		}

		:global(.nav .nav-cta) {
			background: white;
			color: #17181c;
			box-shadow: none;
		}

		[data-reveal] {
			opacity: 0;
			transform: translateY(18px);
			transition: opacity 0.7s ease calc(var(--delay, 0) * 1ms), transform 0.7s ease calc(var(--delay, 0) * 1ms);
		}

		[data-reveal].is-visible {
			opacity: 1;
			transform: none;
		}

		@media (prefers-reduced-motion: reduce) {
			[data-reveal] {
				opacity: 1;
				transform: none;
				transition: none;
			}
		}
	</style>
</MarketingLayout>

---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';

/**
 * Standalone layout for the marketing surfaces (`/` and `/pricing`).
 *
 * These pages sit outside Starlight on purpose: they need full control of the
 * page shell for the scroll-driven sections, while every route under the docs
 * sidebar keeps rendering through Starlight as before.
 */
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://zelavis.com').href;
const social = 'https://zelavis.com/brand/zelavis-social-card.png';
const platformColumns = [
	{ title: 'Build', links: [
		{ label: 'Zelavis App', href: '/packages/app' },
		{ label: 'Authentication', href: '/architecture/access-control' },
		{ label: 'Content and media', href: '/packages/app' },
		{ label: 'Workloads', href: '/packages/app' },
		{ label: 'Project recipes', href: '/architecture/platform-project-recipes' },
		{ label: 'File storage', href: '/guides/file-storage-flow' },
	] },
	{ title: 'Data', links: [
		{ label: 'Multi-model database', href: '/api/database' },
		{ label: 'Documents and events', href: '/api/database' },
		{ label: 'Sharding topology', href: '/architecture/project-model' },
		{ label: 'Storage engines', href: '/adapters' },
	] },
	{ title: 'Operate', links: [
		{ label: 'Platform Fabric', href: '/architecture/project-model' },
		{ label: 'Runtime targets', href: '/reference/runtime-targets' },
		{ label: 'Native website hosting', href: '/architecture/website-core-service' },
		{ label: 'Dashboard', href: '/packages/ui' },
		{ label: 'Assistant runtime', href: '/architecture/assistant-runtime' },
	] },
	{ title: 'Extend', links: [
		{ label: 'Services', href: '/guides/service-authoring' },
		{ label: 'Plugins', href: '/guides/plugin-api' },
		{ label: 'Frontends', href: '/architecture/service-model' },
		{ label: 'Marketplace', href: '/packages/marketplace' },
	] },
];

const solutionColumns = [
	{ title: 'Project', links: [
		{ label: 'Zelavis Apps', href: '/packages/app' },
		{ label: 'Managed applications', href: '/architecture/project-model' },
		{ label: 'Static websites', href: '/architecture/website-core-service' },
	] },
	{ title: 'Team', links: [
		{ label: 'Product', href: '/docs' },
		{ label: 'Engineering', href: '/guides/service-authoring' },
		{ label: 'Content', href: '/packages/app' },
	] },
	{ title: 'Scale', links: [
		{ label: 'Single server', href: '/reference/runtime-targets' },
		{ label: 'Distributed fleet', href: '/architecture/project-model' },
		{ label: 'Self-hosted', href: '/getting-started/installation' },
	] },
];

const resourceColumns = [
	{ title: 'Learn', links: [
		{ label: 'Documentation', href: '/docs' },
		{ label: 'Getting started', href: '/getting-started' },
		{ label: 'Guides', href: '/guides' },
		{ label: 'Architecture', href: '/architecture' },
	] },
	{ title: 'Develop', links: [
		{ label: 'API reference', href: '/api' },
		{ label: 'Packages', href: '/packages' },
		{ label: 'Service authoring', href: '/guides/service-authoring' },
		{ label: 'Plugin API', href: '/guides/plugin-api' },
	] },
	{ title: 'Project', links: [
		{ label: 'GitHub', href: 'https://github.com/zelavis/zelavis' },
		{ label: 'Contributing', href: 'https://github.com/zelavis/zelavis/blob/main/CONTRIBUTING.md' },
		{ label: 'Security', href: 'https://github.com/zelavis/zelavis/blob/main/SECURITY.md' },
		{ label: 'Versioning', href: '/reference/versioning' },
	] },
	{ title: 'Explore', links: [
		{ label: 'Environment variables', href: '/reference/environment-variables' },
		{ label: 'Route conventions', href: '/reference/route-conventions' },
		{ label: 'Dashboard settings', href: '/reference/dashboard-settings' },
		{ label: 'Marketplace catalog', href: '/reference/service-marketplace-catalog' },
	] },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" href="/favicon.svg" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={social} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={social} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header class="nav" data-nav>
			<div class="nav-shell" data-nav-shell>
			<div class="nav-inner">
				<a class="brand" href="/" aria-label="Zelavis home">
					<svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
						<path
							fill="currentColor"
							d="M37 25h62c5 0 7 6 4 9L49 91h45c5 0 7 6 4 9l-7 7c-2 2-4 3-7 3H22c-5 0-7-6-4-9l54-57H27c-5 0-7-6-4-9l7-7c2-2 4-3 7-3Z"
						/>
						<path
							fill="currentColor"
							fill-opacity=".38"
							d="M72 44h27c5 0 7-6 4-9l-7-7c-2-2-4-3-7-3H63L49 44h23ZM56 91H29c-5 0-7 6-4 9l7 7c2 2 4 3 7 3h26l14-19H56Z"
						/>
					</svg>
					<span class="brand-word">Zelavis</span>
				</a>

				<nav class="nav-links" aria-label="Main navigation">
					<button type="button" data-menu-trigger="platform" aria-expanded="false">Platform</button>
					<button type="button" data-menu-trigger="solutions" aria-expanded="false">Solutions</button>
					<button type="button" data-menu-trigger="resources" aria-expanded="false">Resources</button>
					<a href="/pricing">Pricing</a>
				</nav>

				<div class="nav-actions">
					<a class="nav-login" href="/zelavis/login">Login</a>
					<a class="btn btn-sm btn-primary nav-cta" href="/pricing">Get Zelavis Plus</a>
				</div>
				<button class="nav-mobile-toggle" type="button" aria-expanded="false" aria-controls="mobile-navigation" data-mobile-menu-toggle>
					<span></span><span></span><span class="sr-only">Menu</span>
				</button>
			</div>

			<div class="mega-stage" data-mega-stage hidden>
			<div class="mega-menu" data-menu="platform" aria-hidden="true" inert>
				<div class="mega-grid mega-grid-four">
					{platformColumns.map((column) => (
						<div class="mega-column"><h2>{column.title}</h2>{column.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>
					))}
				</div>
			</div>

			<div class="mega-menu" data-menu="solutions" aria-hidden="true" inert>
				<div class="mega-solutions">
					<a class="mega-feature" href="/docs">
						<span class="mega-feature-art" aria-hidden="true"><i></i><i></i><i></i></span>
						<strong>One platform for the whole product</strong>
						<p>Move from first project to production without stitching the authority model together later.</p>
						<b>Explore Zelavis <span>→</span></b>
					</a>
					<div class="mega-grid mega-grid-three">
						{solutionColumns.map((column) => (
							<div class="mega-column"><h2>{column.title}</h2>{column.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>
						))}
					</div>
				</div>
			</div>

			<div class="mega-menu" data-menu="resources" aria-hidden="true" inert>
				<div class="mega-grid mega-grid-four">
					{resourceColumns.map((column) => (
						<div class="mega-column"><h2>{column.title}</h2>{column.links.map((link) => <a href={link.href}>{link.label}</a>)}</div>
					))}
				</div>
			</div>
			</div>

			<div class="mobile-menu" id="mobile-navigation" data-mobile-menu hidden>
				<details><summary>Platform</summary><div>{platformColumns.flatMap((column) => column.links).map((link) => <a href={link.href}>{link.label}</a>)}</div></details>
				<details><summary>Solutions</summary><div>{solutionColumns.flatMap((column) => column.links).map((link) => <a href={link.href}>{link.label}</a>)}</div></details>
				<details><summary>Resources</summary><div>{resourceColumns.flatMap((column) => column.links).map((link) => <a href={link.href}>{link.label}</a>)}</div></details>
				<a href="/pricing">Pricing</a>
			</div>
			</div>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="footer">
			<div class="footer-inner">
				<div class="footer-brand">
					<svg class="brand-mark" viewBox="0 0 128 128" aria-hidden="true">
						<path
							fill="currentColor"
							d="M37 25h62c5 0 7 6 4 9L49 91h45c5 0 7 6 4 9l-7 7c-2 2-4 3-7 3H22c-5 0-7-6-4-9l54-57H27c-5 0-7-6-4-9l7-7c2-2 4-3 7-3Z"
						/>
					</svg>
					<p>Plan, build, and manage apps together, from first ticket to production.</p>
				</div>
				<div class="footer-cols">
					<div>
						<h3>Product</h3>
						<a href="/pricing">Pricing</a>
						<a href="/getting-started/installation">Install</a>
						<a href="/architecture/project-model">Architecture</a>
					</div>
					<div>
						<h3>Docs</h3>
						<a href="/docs">Overview</a>
						<a href="/getting-started/first-runtime">First runtime</a>
						<a href="/reference/environment-variables">Reference</a>
					</div>
					<div>
						<h3>Project</h3>
						<a href="https://github.com/zelavis/zelavis" rel="noopener">GitHub</a>
						<a href="https://github.com/zelavis/zelavis/blob/main/CONTRIBUTING.md" rel="noopener">Contributing</a>
						<a href="https://github.com/zelavis/zelavis/blob/main/SECURITY.md" rel="noopener">Security</a>
					</div>
				</div>
			</div>
			<div class="footer-base">
				<span>&copy; {new Date().getFullYear()} Zelavis</span>
				<span>Run it managed on zelavis.com, or host it yourself.</span>
			</div>
		</footer>

		<script is:inline>
			(function () {
				var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

				// Scroll-triggered section reveals.
				var revealables = document.querySelectorAll('[data-reveal]');
				if (reduced || !('IntersectionObserver' in window)) {
					revealables.forEach(function (el) {
						el.classList.add('is-visible');
					});
				} else {
					var revealObserver = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (entry) {
								if (!entry.isIntersecting) return;
								entry.target.classList.add('is-visible');
								revealObserver.unobserve(entry.target);
							});
						},
						{ threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
					);
					revealables.forEach(function (el) {
						revealObserver.observe(el);
					});
				}

				// Bars and counters animate the first time their panel scrolls in.
				function runMetric(el) {
					var target = parseFloat(el.dataset.count || '0');
					var decimals = parseInt(el.dataset.decimals || '0', 10);
					var suffix = el.dataset.suffix || '';
					var prefix = el.dataset.prefix || '';
					if (reduced) {
						el.textContent = prefix + target.toFixed(decimals) + suffix;
						return;
					}
					var duration = 1100;
					var start = 0;
					function frame(now) {
						if (!start) start = now;
						var progress = Math.min((now - start) / duration, 1);
						var eased = 1 - Math.pow(1 - progress, 3);
						el.textContent = prefix + (target * eased).toFixed(decimals) + suffix;
						if (progress < 1) requestAnimationFrame(frame);
					}
					requestAnimationFrame(frame);
				}

				var panels = document.querySelectorAll('[data-metrics]');
				function activate(panel) {
					panel.classList.add('is-running');
					panel.querySelectorAll('[data-count]').forEach(runMetric);
				}
				if (!('IntersectionObserver' in window)) {
					panels.forEach(activate);
				} else {
					var metricObserver = new IntersectionObserver(
						function (entries) {
							entries.forEach(function (entry) {
								if (!entry.isIntersecting) return;
								activate(entry.target);
								metricObserver.unobserve(entry.target);
							});
						},
						{ threshold: 0.35 },
					);
					panels.forEach(function (panel) {
						metricObserver.observe(panel);
					});
				}

				// Keep the header out of the reading path while preserving quick access on upward intent.
				var header = document.querySelector('[data-nav]');
				if (header) {
					var lastScrollY = Math.max(window.scrollY, 0);
					var upwardDistance = 0;
					var hasSectionNavigator = function () {
						return !!document.querySelector('[data-local-nav]') && window.matchMedia('(min-width: 1351px)').matches;
					};
					var menuIsActive = function () {
						var shell = document.querySelector('[data-nav-shell]');
						var keyboardFocusActive = shell && shell.querySelector(':focus-visible');
						return shell && (
							shell.classList.contains('is-open') ||
							shell.classList.contains('is-mobile-open') ||
							keyboardFocusActive
						);
					};
					var onScroll = function () {
						var currentScrollY = Math.max(window.scrollY, 0);
						var delta = currentScrollY - lastScrollY;
						header.classList.toggle('is-stuck', currentScrollY > 12);

						if (currentScrollY <= 80) {
							header.classList.remove('is-hidden');
							header.classList.remove('is-revealed');
							upwardDistance = 0;
						} else if (delta < -1) {
							upwardDistance += Math.abs(delta);
							if (upwardDistance >= 10) {
								header.classList.remove('is-hidden');
								header.classList.add('is-revealed');
								upwardDistance = 0;
							}
						} else if (delta > 1) {
							upwardDistance = 0;
							var sectionNavigatorReached = document.documentElement.classList.contains('local-navigation-reached');
							if (hasSectionNavigator() && !sectionNavigatorReached) {
								header.classList.remove('is-hidden');
								header.classList.add('is-revealed');
							} else if (!menuIsActive()) {
								header.classList.add('is-hidden');
							}
						}
						lastScrollY = currentScrollY;
					};
					onScroll();
					window.addEventListener('scroll', onScroll, { passive: true });
					window.addEventListener('local-nav-first-visible', function () {
						if (window.scrollY <= 80 || menuIsActive()) return;
						header.classList.add('is-revealed');
						header.classList.add('is-hidden');
					});
				}

				// Desktop mega menus and the compact mobile navigation share one state owner.
				var navShell = document.querySelector('[data-nav-shell]');
				var menuTriggers = Array.from(document.querySelectorAll('[data-menu-trigger]'));
				var megaMenus = Array.from(document.querySelectorAll('[data-menu]'));
				var megaStage = document.querySelector('[data-mega-stage]');
				var mobileToggle = document.querySelector('[data-mobile-menu-toggle]');
				var mobileMenu = document.querySelector('[data-mobile-menu]');
				var closeTimer;
				var closeAnimationTimer;

				function setActiveMenu(name) {
					var activeMenu;
					megaMenus.forEach(function (menu) {
						var isActive = menu.dataset.menu === name;
						menu.classList.toggle('is-active', isActive);
						menu.setAttribute('aria-hidden', isActive ? 'false' : 'true');
						menu.inert = !isActive;
						if (isActive) activeMenu = menu;
					});
					if (megaStage && activeMenu) {
						megaStage.style.height = activeMenu.scrollHeight + 'px';
					}
				}

				function closeMenus() {
					clearTimeout(closeTimer);
					clearTimeout(closeAnimationTimer);
					menuTriggers.forEach(function (trigger) { trigger.setAttribute('aria-expanded', 'false'); });
					if (navShell) navShell.classList.add('is-closing');
					if (megaStage) {
						megaStage.classList.remove('is-visible');
						megaStage.style.height = '0px';
					}
					closeAnimationTimer = setTimeout(function () {
						megaMenus.forEach(function (menu) {
							menu.classList.remove('is-active');
							menu.setAttribute('aria-hidden', 'true');
							menu.inert = true;
						});
						if (megaStage) {
							megaStage.hidden = true;
							megaStage.style.height = '';
						}
						if (navShell) navShell.classList.remove('is-open', 'is-closing');
					}, 240);
				}

				function openMenu(name) {
					clearTimeout(closeTimer);
					clearTimeout(closeAnimationTimer);
					if (!window.matchMedia('(min-width: 821px)').matches) return;
					if (header) header.classList.remove('is-hidden');
					menuTriggers.forEach(function (trigger) {
						trigger.setAttribute('aria-expanded', trigger.dataset.menuTrigger === name ? 'true' : 'false');
					});
					if (megaStage) megaStage.hidden = false;
					if (navShell) {
						navShell.classList.remove('is-closing');
						navShell.classList.add('is-open');
					}
					setActiveMenu(name);
					if (megaStage) {
						requestAnimationFrame(function () { megaStage.classList.add('is-visible'); });
					}
				}

				menuTriggers.forEach(function (trigger) {
					trigger.addEventListener('mouseenter', function () { openMenu(trigger.dataset.menuTrigger); });
					trigger.addEventListener('focus', function () { openMenu(trigger.dataset.menuTrigger); });
					trigger.addEventListener('click', function () {
						openMenu(trigger.dataset.menuTrigger);
					});
				});

				if (navShell) {
					navShell.addEventListener('mouseleave', function () {
						closeTimer = setTimeout(closeMenus, 150);
					});
					navShell.addEventListener('mouseenter', function () { clearTimeout(closeTimer); });
				}

				if (mobileToggle && mobileMenu && navShell) {
					mobileToggle.addEventListener('click', function () {
						var open = mobileToggle.getAttribute('aria-expanded') !== 'true';
						if (open && header) header.classList.remove('is-hidden');
						mobileToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
						mobileMenu.hidden = !open;
						navShell.classList.toggle('is-mobile-open', open);
					});
				}

				document.addEventListener('pointerdown', function (event) {
					if (navShell && !navShell.contains(event.target)) closeMenus();
				});
				document.addEventListener('keydown', function (event) {
					if (event.key !== 'Escape') return;
					closeMenus();
					if (mobileToggle && mobileMenu && navShell) {
						mobileToggle.setAttribute('aria-expanded', 'false');
						mobileMenu.hidden = true;
						navShell.classList.remove('is-mobile-open');
					}
				});

				// Copy-to-clipboard for the install commands.
				document.querySelectorAll('[data-copy]').forEach(function (button) {
					button.addEventListener('click', function () {
						var value = button.getAttribute('data-copy') || '';
						var done = function () {
							button.classList.add('is-copied');
							button.setAttribute('aria-label', 'Copied');
							setTimeout(function () {
								button.classList.remove('is-copied');
								button.setAttribute('aria-label', 'Copy to clipboard');
							}, 1600);
						};
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(value).then(done, function () {});
						}
					});
				});
			})();
		</script>

		<style is:global>
			:root {
				--bg: hsl(0 0% 4%);
				--bg-1: hsl(0 0% 7%);
				--bg-2: hsl(0 0% 10%);
				--line: hsl(0 0% 17%);
				--line-soft: hsl(0 0% 13%);
				--text: hsl(0 0% 96%);
				--text-2: hsl(0 0% 68%);
				--text-3: hsl(0 0% 48%);
				--accent: hsl(26 100% 58%);
				--accent-soft: hsl(26 100% 58% / 0.14);
				--accent-2: hsl(348 96% 64%);
				--radius: 14px;
				--max: 1120px;
				--ease: cubic-bezier(0.16, 1, 0.3, 1);
				--font: 'Poppins', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto,
					'Helvetica Neue', Arial, sans-serif;
				--mono: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas,
					'Liberation Mono', monospace;
				color-scheme: dark;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			@media (prefers-reduced-motion: reduce) {
				html {
					scroll-behavior: auto;
				}
			}

			body {
				margin: 0;
				background: var(--bg);
				color: var(--text);
				font-family: var(--font);
				font-size: 16px;
				line-height: 1.6;
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			img {
				max-width: 100%;
			}

			a {
				color: inherit;
			}

			.skip {
				position: absolute;
				left: -9999px;
				top: 0;
				background: var(--accent);
				color: hsl(0 0% 8%);
				padding: 0.6rem 1rem;
				z-index: 100;
				border-radius: 0 0 10px 0;
				font-weight: 700;
			}

			.skip:focus {
				left: 0;
			}

			.wrap {
				width: 100%;
				max-width: var(--max);
				margin: 0 auto;
				padding-inline: 24px;
			}

			/* ---------- reveal primitives ---------- */

			[data-reveal] {
				opacity: 0;
				transform: translateY(26px);
				transition:
					opacity 0.75s var(--ease),
					transform 0.75s var(--ease);
				transition-delay: calc(var(--delay, 0) * 1ms);
			}

			[data-reveal].is-visible {
				opacity: 1;
				transform: none;
			}

			@media (prefers-reduced-motion: reduce) {
				[data-reveal] {
					opacity: 1;
					transform: none;
					transition: none;
				}
			}

			/* ---------- buttons ---------- */

			.btn {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 0.5rem;
				border-radius: 10px;
				border: 1px solid transparent;
				padding: 0.8rem 1.35rem;
				font-size: 0.95rem;
				font-weight: 650;
				text-decoration: none;
				cursor: pointer;
				transition:
					transform 0.2s var(--ease),
					background 0.2s var(--ease),
					border-color 0.2s var(--ease),
					box-shadow 0.2s var(--ease);
			}

			.btn:hover {
				transform: translateY(-1px);
			}

			.btn-primary {
				background: var(--accent);
				color: hsl(24 60% 8%);
				box-shadow: 0 8px 30px hsl(26 100% 50% / 0.22);
			}

			.btn-primary:hover {
				background: hsl(26 100% 63%);
			}

			.btn-ghost {
				background: hsl(0 0% 100% / 0.04);
				border-color: var(--line);
				color: var(--text);
			}

			.btn-ghost:hover {
				border-color: hsl(0 0% 30%);
				background: hsl(0 0% 100% / 0.07);
			}

			.btn-sm {
				padding: 0.55rem 0.95rem;
				font-size: 0.875rem;
			}

			/* ---------- header ---------- */

			.nav {
				position: sticky;
				top: 0;
				z-index: 50;
				padding-top: 16px;
				transform: translateY(0);
				transition: background 0.3s var(--ease), backdrop-filter 0.3s var(--ease), transform 0.32s var(--ease);
				will-change: transform;
			}

			.nav.is-hidden {
				transform: translateY(calc(-100% - 20px));
				pointer-events: none;
			}

			.nav.is-stuck {
				background: transparent;
				backdrop-filter: none;
			}

			@media (prefers-reduced-motion: reduce) {
				.nav { transition: none; }
			}

			.nav-shell {
				position: relative;
				width: min(1220px, calc(100% - 60px));
				margin: 0 auto;
				border-radius: 30px;
				transition: background 0.22s var(--ease), color 0.22s var(--ease), box-shadow 0.22s var(--ease), border-radius 0.24s var(--ease);
			}

			.nav.is-stuck.is-revealed .nav-shell {
				background: rgba(245, 247, 249, 0.9);
				color: #090a0d;
				-webkit-backdrop-filter: blur(30px);
				backdrop-filter: blur(30px);
			}

			.nav-shell.is-open {
				background: #fff;
				color: #14151a;
				border-radius: 30px 30px 0 0;
				box-shadow: 0 26px 70px hsl(240 55% 12% / 0.2);
			}

			.nav-shell.is-open.is-closing {
				border-radius: 30px;
			}

			.nav.is-stuck .nav-shell.is-open {
				background: #fff;
				-webkit-backdrop-filter: none;
				backdrop-filter: none;
			}

			.nav-inner {
				height: 64px;
				padding: 0 16px;
				display: flex;
				align-items: center;
				gap: 1.4rem;
			}

			.brand {
				display: inline-flex;
				align-items: center;
				gap: 0.55rem;
				text-decoration: none;
				font-weight: 800;
				letter-spacing: -0.02em;
				font-size: 1.05rem;
				color: var(--text);
			}

			.brand-mark {
				width: 26px;
				height: 26px;
				color: var(--accent);
			}

			.nav-links {
				display: flex;
				align-items: center;
				gap: 0;
				font-size: 1rem;
			}

			.nav-links a,
			.nav-links button {
				padding: 0.4375rem 1rem;
				border: 0;
				border-radius: 999px;
				background: transparent;
				color: var(--text-2);
				font: inherit;
				font-weight: 600;
				text-decoration: none;
				cursor: pointer;
				transition: color 0.2s var(--ease), background 0.2s var(--ease);
			}

			.nav-links a:hover,
			.nav-links button:hover,
			.nav-links button[aria-expanded="true"] {
				color: var(--text);
				background: hsl(0 0% 100% / 0.1);
			}

			.nav-actions {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 1.25rem;
			}

			.nav-login {
				color: var(--text-2);
				text-decoration: none;
				font-size: 0.92rem;
				font-weight: 600;
			}

			.nav-login:hover {
				color: var(--text);
			}

			.nav-cta {
				background: #fff;
				color: #111217;
				box-shadow: none;
			}

			.nav-cta:hover {
				background: #f3f3f3;
			}

			.nav.is-stuck.is-revealed .brand-word,
			.nav.is-stuck.is-revealed .nav-links a,
			.nav.is-stuck.is-revealed .nav-links button,
			.nav.is-stuck.is-revealed .nav-login {
				color: #090a0d;
			}

			.nav.is-stuck.is-revealed .nav-links a:hover,
			.nav.is-stuck.is-revealed .nav-links button:hover,
			.nav.is-stuck.is-revealed .nav-links button[aria-expanded="true"] {
				background: #f3f3f3;
				color: #090a0d;
			}

			.nav.is-stuck.is-revealed .nav-cta {
				background: #090a0d;
				color: #fff;
			}

			.nav.is-stuck.is-revealed .nav-cta:hover {
				background: #27282d;
			}

			.nav-shell.is-open .brand-word,
			.nav-shell.is-open .nav-links a,
			.nav-shell.is-open .nav-links button,
			.nav-shell.is-open .nav-login {
				color: #17181d;
			}

			.nav-shell.is-open .nav-links a:hover,
			.nav-shell.is-open .nav-links button:hover,
			.nav-shell.is-open .nav-links button[aria-expanded="true"] {
				background: #f1f1f3;
			}

			.nav-shell.is-open .nav-cta {
				background: #111217;
				color: #fff;
			}

			.mega-stage {
				position: absolute;
				top: 62px;
				left: 0;
				right: 0;
				overflow: hidden;
				border-radius: 0 0 30px 30px;
				background: #fff;
				color: #17181d;
				transform-origin: top;
				opacity: 0;
				transform: translateY(-7px) scaleY(0.985);
				transition:
					height 0.38s cubic-bezier(0.22, 1, 0.36, 1),
					opacity 0.18s ease,
					transform 0.28s cubic-bezier(0.22, 1, 0.36, 1);
			}

			.mega-stage.is-visible {
				opacity: 1;
				transform: none;
			}

			.mega-menu {
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				padding: 18px 32px 32px;
				opacity: 0;
				transform: translateY(10px);
				pointer-events: none;
				transition:
					opacity 0.2s ease,
					transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
			}

			.mega-menu.is-active {
				opacity: 1;
				transform: none;
				pointer-events: auto;
			}

			.mega-grid {
				display: grid;
				gap: 0;
			}

			.mega-grid-four { grid-template-columns: repeat(4, 1fr); }
			.mega-grid-three { grid-template-columns: repeat(3, 1fr); }

			.mega-column {
				display: flex;
				flex-direction: column;
				gap: 0;
			}

			.mega-column h2 {
				margin: 0 0 12px;
				padding: 0 12px;
				color: #868d95;
				font-size: 1rem;
				font-weight: 600;
				line-height: 1.35;
			}

			.mega-column a {
				width: 100%;
				padding: 8px 12px;
				border-radius: 6px;
				color: #1c1d22;
				font-size: 1.125rem;
				font-weight: 400;
				line-height: 1.55;
				text-decoration: none;
				transition: background-color 0.2s cubic-bezier(0.4, 0, 0.2, 1);
			}

			.mega-column a:hover,
			.mega-column a:focus-visible {
				background: #f2f4f8;
				color: #090a0d;
			}

			.mega-solutions {
				display: grid;
				grid-template-columns: 300px 1fr;
				gap: 34px;
			}

			.mega-feature {
				min-height: 330px;
				padding: 24px;
				display: flex;
				flex-direction: column;
				border-radius: 14px;
				overflow: hidden;
				background: radial-gradient(circle at 80% 10%, #5048f0, transparent 38%), linear-gradient(145deg, #102359, #090b15 72%);
				color: #fff;
				text-decoration: none;
			}

			.mega-feature-art { position: relative; height: 126px; }
			.mega-feature-art i { position: absolute; left: 12%; width: 76%; height: 28px; border-radius: 999px; background: linear-gradient(90deg, #416eff, #8b5cff); transform: rotate(var(--r)); box-shadow: 0 10px 24px #2224a8; }
			.mega-feature-art i:nth-child(1) { top: 16px; --r: 27deg; }
			.mega-feature-art i:nth-child(2) { top: 48px; --r: -25deg; }
			.mega-feature-art i:nth-child(3) { top: 78px; --r: 20deg; }
			.mega-feature strong { font-size: 1.35rem; line-height: 1.15; }
			.mega-feature p { margin: 0.6rem 0 1rem; color: #cacbd7; font-size: 0.9rem; line-height: 1.45; }
			.mega-feature b { margin-top: auto; font-size: 0.9rem; }

			.nav-mobile-toggle,
			.mobile-menu { display: none; }

			.sr-only {
				position: absolute;
				width: 1px;
				height: 1px;
				padding: 0;
				margin: -1px;
				overflow: hidden;
				clip: rect(0, 0, 0, 0);
				white-space: nowrap;
				border: 0;
			}

			@media (max-width: 820px) {
				.nav { padding-top: 10px; }
				.nav-shell { width: calc(100% - 20px); }
				.nav-links {
					display: none;
				}

				.nav-mobile-toggle {
					width: 42px;
					height: 42px;
					padding: 0;
					display: grid;
					place-content: center;
					gap: 5px;
					border: 1px solid hsl(0 0% 100% / 0.28);
					border-radius: 50%;
					background: transparent;
					color: inherit;
				}

				.nav-mobile-toggle > span:not(.sr-only) { width: 16px; height: 1px; background: currentColor; transition: transform 0.2s ease; }
				.nav-shell.is-mobile-open { background: #fff; color: #17181d; box-shadow: 0 24px 60px hsl(240 55% 12% / 0.22); }
				.nav-shell.is-mobile-open .brand-word,
				.nav-shell.is-mobile-open .nav-login,
				.nav-shell.is-mobile-open .nav-mobile-toggle { color: #17181d; }
				.nav-shell.is-mobile-open .nav-mobile-toggle > span:first-child { transform: translateY(3px) rotate(45deg); }
				.nav-shell.is-mobile-open .nav-mobile-toggle > span:nth-child(2) { transform: translateY(-3px) rotate(-45deg); }
				.mobile-menu { padding: 0 18px 24px; border-radius: 0 0 24px 24px; background: #fff; color: #17181d; }
				.mobile-menu:not([hidden]) { display: block; }
				.mobile-menu details { border-top: 1px solid #e7e7ea; }
				.mobile-menu summary,
				.mobile-menu > a { padding: 17px 0; display: block; color: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
				.mobile-menu details div { padding: 0 0 15px 14px; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 18px; }
				.mobile-menu details a { color: #696b75; font-size: 0.84rem; text-decoration: none; }
				.mega-stage { display: none; }

				.nav-cta {
					margin-left: 0;
				}
			}

			@media (max-width: 600px) {
				.nav-inner { gap: 0.7rem; }
				.brand-word { display: none; }
				.nav-actions { gap: 0.7rem; }
			}

			/* ---------- shared section furniture ---------- */

			.section {
				padding-block: clamp(72px, 11vw, 130px);
			}

			.eyebrow {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				font-size: 0.78rem;
				font-weight: 700;
				letter-spacing: 0.09em;
				text-transform: uppercase;
				color: var(--accent);
				margin: 0 0 1rem;
			}

			.section-title {
				font-size: clamp(2rem, 4.6vw, 3.1rem);
				line-height: 1.08;
				letter-spacing: -0.035em;
				margin: 0 0 1rem;
				font-weight: 800;
			}

			.section-lede {
				color: var(--text-2);
				font-size: clamp(1rem, 1.5vw, 1.15rem);
				max-width: 62ch;
				margin: 0;
			}

			.card {
				background: linear-gradient(180deg, var(--bg-1), var(--bg));
				border: 1px solid var(--line-soft);
				border-radius: var(--radius);
				padding: 1.6rem;
				transition:
					border-color 0.3s var(--ease),
					transform 0.3s var(--ease);
			}

			.card:hover {
				border-color: var(--line);
				transform: translateY(-3px);
			}

			.badge {
				display: inline-block;
				font-size: 0.68rem;
				font-weight: 750;
				letter-spacing: 0.07em;
				text-transform: uppercase;
				padding: 0.2rem 0.5rem;
				border-radius: 999px;
				border: 1px solid var(--line);
				color: var(--text-3);
				vertical-align: middle;
			}

			.badge-roadmap {
				color: var(--accent);
				border-color: hsl(26 100% 58% / 0.4);
				background: var(--accent-soft);
			}

			/* ---------- code + copy ---------- */

			.terminal {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				background: var(--bg-1);
				border: 1px solid var(--line-soft);
				border-radius: 12px;
				padding: 0.75rem 0.75rem 0.75rem 1rem;
				font-family: var(--mono);
				font-size: 0.88rem;
				max-width: 100%;
				overflow-x: auto;
			}

			.terminal .prompt {
				color: var(--accent);
				user-select: none;
			}

			.terminal code {
				white-space: nowrap;
				color: var(--text);
			}

			.copy {
				margin-left: auto;
				background: transparent;
				border: 1px solid var(--line);
				color: var(--text-2);
				border-radius: 8px;
				padding: 0.3rem 0.6rem;
				font-size: 0.75rem;
				font-family: var(--font);
				cursor: pointer;
				transition: all 0.2s var(--ease);
			}

			.copy:hover {
				color: var(--text);
				border-color: hsl(0 0% 32%);
			}

			.copy.is-copied {
				color: var(--accent);
				border-color: var(--accent);
			}

			.copy.is-copied::after {
				content: ' ✓';
			}

			/* ---------- footer ---------- */

			.footer {
				border-top: 1px solid var(--line-soft);
				background: var(--bg-1);
				padding-block: 56px 28px;
			}

			.footer-inner {
				max-width: var(--max);
				margin: 0 auto;
				padding-inline: 24px;
				display: flex;
				flex-wrap: wrap;
				gap: 2.5rem;
				justify-content: space-between;
			}

			.footer-brand {
				max-width: 300px;
			}

			.footer-brand .brand-mark {
				width: 30px;
				height: 30px;
				color: var(--accent);
			}

			.footer-brand p {
				color: var(--text-3);
				font-size: 0.9rem;
				margin: 0.75rem 0 0;
			}

			.footer-cols {
				display: flex;
				flex-wrap: wrap;
				gap: 3rem;
			}

			.footer-cols h3 {
				font-size: 0.78rem;
				text-transform: uppercase;
				letter-spacing: 0.09em;
				color: var(--text-3);
				margin: 0 0 0.85rem;
			}

			.footer-cols a {
				display: block;
				color: var(--text-2);
				text-decoration: none;
				font-size: 0.9rem;
				margin-bottom: 0.5rem;
				transition: color 0.2s var(--ease);
			}

			.footer-cols a:hover {
				color: var(--accent);
			}

			.footer-base {
				max-width: var(--max);
				margin: 40px auto 0;
				padding: 20px 24px 0;
				border-top: 1px solid var(--line-soft);
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				justify-content: space-between;
				color: var(--text-3);
				font-size: 0.85rem;
			}
		</style>
	</body>
</html>

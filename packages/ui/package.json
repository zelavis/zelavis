{
  "name": "@zelavis/ui",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Zelavis dashboard SPA packaged as a system plugin.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/dashboard-service.js",
  "types": "./dist/dashboard-service.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dashboard-service.d.ts",
      "import": "./dist/dashboard-service.js"
    },
    "./service": {
      "types": "./dist/dashboard-service.d.ts",
      "import": "./dist/dashboard-service.js"
    }
  },
  "files": [
    "dist",
    "build/client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/ui"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "scripts": {
    "build": "react-router build && node scripts/copy-dashboard-assets.mjs && tsc -p tsconfig.plugin.json",
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "dev": "react-router dev --port 3000",
    "dev:mounted": "ZELAVIS_UI_BASE_PATH=/zelavis/ react-router dev --port 3000",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run --passWithNoTests --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:mounted": "ZELAVIS_UI_BASE_PATH=/zelavis/ playwright test",
    "typecheck": "react-router typegen && tsc && tsc -p tsconfig.plugin.json --noEmit"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.14",
    "@assistant-ui/react": "0.15.15",
    "@assistant-ui/react-markdown": "^0.14.11",
    "@assistant-ui/store": "0.3.10",
    "@base-ui/react": "^1.5.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/montserrat": "^5.2.8",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@lexical/history": "^0.45.0",
    "@lexical/html": "^0.45.0",
    "@lexical/link": "^0.45.0",
    "@lexical/list": "^0.45.0",
    "@lexical/react": "^0.45.0",
    "@lexical/rich-text": "^0.45.0",
    "@lexical/selection": "^0.45.0",
    "@react-router/node": "7.17.0",
    "@react-router/serve": "7.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "embla-carousel-react": "^8.6.0",
    "isbot": "^5.1.41",
    "lexical": "^0.45.0",
    "lucide-react": "^0.577.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "7.16.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.15",
    "isbot": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "7.16.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}

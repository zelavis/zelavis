  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@paypal/paypal-server-sdk": "^2.3.0",
    "@zelavis/ecommerce": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "paypal",
    "commerce",
    "ecommerce",
    "payments",
    "plugin"

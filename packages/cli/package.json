{
  "name": "@zelavis/cli",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Command-line operations for the Zelavis Platform OS.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "bin": {
    "zelavis": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zelavis",
    "cli",
    "platform",
    "operations"
  ],
  "engines": {
    "node": ">=24"
  }
}

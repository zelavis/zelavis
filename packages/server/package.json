{
  "name": "@zelavis/server",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Unified endpoint contract and framework adapters for zelavis server packages.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/elysia": {
      "types": "./dist/adapters/elysia.d.ts",
      "import": "./dist/adapters/elysia.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js"
    },
    "./adapters/h3": {
      "types": "./dist/adapters/h3.d.ts",
      "import": "./dist/adapters/h3.js"
    },
    "./adapters/nextjs-pages-router": {
      "types": "./dist/adapters/nextjs-pages-router.d.ts",
      "import": "./dist/adapters/nextjs-pages-router.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "peerDependencies": {
    "elysia": "^1.4.0",
    "express": "^4.18.0 || ^5.0.0",
    "fastify": "^5.0.0",
    "h3": "^2.0.0",
    "hono": "^4.12.34",
    "next": "^16.2.5"
  },
  "peerDependenciesMeta": {
    "elysia": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.3",
    "elysia": "^1.4.29",
    "express": "^5.0.0",
    "fastify": "^5.9.0",
    "h3": "2.0.1-rc.22",
    "hono": "^4.12.34",
    "next": "16.2.11",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "server",
    "endpoints",
    "elysia",
    "express",
    "fastify",
    "h3",
    "hono",
    "nextjs",
    "pages-router",
    "adapter"
  ]
}

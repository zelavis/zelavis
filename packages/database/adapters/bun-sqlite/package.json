{
  "name": "@zelavis/database-bun-sqlite",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Bun bun:sqlite adapter for @zelavis/database.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zelavis/database build && pnpm run build && (command -v bun >/dev/null 2>&1 && bun test test/*.test.ts || echo 'Skipping bun-sqlite tests because Bun is not installed.')"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/database/adapters/bun-sqlite"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/database/adapters/bun-sqlite#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "database",
    "sqlite",
    "bun",
    "bun:sqlite",
    "adapter"
  ]
}

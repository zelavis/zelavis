{
  "name": "@zelavis/database-node-sqlite",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Node.js better-sqlite3 integration for @zelavis/database.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zelavis/database build && pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/database/integrations/node-sqlite"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/database/integrations/node-sqlite#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/database": "workspace:*",
    "better-sqlite3": "^12.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.11.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "database",
    "sqlite",
    "better-sqlite3",
    "node",
    "integration"
  ]
}

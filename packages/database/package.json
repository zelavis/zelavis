{
  "name": "@zelavis/database",
  "version": "1.0.0",
  "private": true,
  "description": "Core database contracts and document primitives for Zelavis services.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zelavis/server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "database",
    "documents",
    "sqlite",
    "multimodel",
    "tenancy"
  ]
}

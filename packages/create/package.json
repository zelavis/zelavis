{
  "name": "@zelavis/create",
  "version": "0.1.0-alpha.1",
  "private": false,
  "description": "Create a Zelavis Platform in a new folder: npm create @zelavis",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "bin": {
    "create-zelavis": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/stamp-versions.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zelavis/zelavis.git",
    "directory": "packages/create"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/create"
}

{
  "name": "@zelavis/db",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Core database contracts and document primitives for Zelavis services.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @zelavis/server build && pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/db"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/db#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/server": "workspace:*",
    "effect": "4.0.0-beta.78"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "database",
    "documents",
    "sqlite",
    "multimodel",
    "tenancy"
  ]
}

{
  "name": "@zelavis/workloads",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "First-party Zelavis Workloads service for project functions, jobs, schedules, and webhooks.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/workloads-service.d.ts",
      "import": "./dist/workloads-service.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/workloads"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@zelavis/server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zelavis",
    "workloads",
    "functions",
    "jobs",
    "webhooks"
  ]
}

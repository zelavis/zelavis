{
  "name": "@zelavis/marketplace",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Official Zelavis marketplace product service.",
  "license": "MIT",
  "type": "module",
  "zelavis": {
    "kind": "plugin",
    "namespace": "marketplace",
    "capabilities": [
      "dashboard:menu",
      "marketplace:services"
    ],
    "marketplace": {
      "title": "Marketplace",
      "summary": "Official Zelavis marketplace product service.",
      "categories": [
        "marketplace"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dashboard"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "zelavis": "workspace:*"
  }
}

{
  "name": "@zelavis/app",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Official Zelavis App project recipe with database, auth, and workloads.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "app",
    "namespace": "app",
    "capabilities": [
      "app:project",
      "dashboard:menu",
      "api:routes"
    ],
    "marketplace": {
      "title": "Zelavis App",
      "summary": "The official Zelavis-native project backend with database, auth, and workloads.",
      "categories": [
        "apps",
        "official"
      ],
      "tags": [
        "backend",
        "database",
        "auth",
        "workloads"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/services/zelavis-app"
  },
  "peerDependencies": {
    "zelavis": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": [
    "zelavis",
    "app",
    "recipe",
    "backend",
    "database",
    "auth",
    "workloads"
  ]
}

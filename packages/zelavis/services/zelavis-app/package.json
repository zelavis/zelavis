{
  "name": "@zelavis/app",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Official Zelavis App project service that composes database, auth, and workloads.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/adapter-core": {
      "types": "./dist/db/adapter-core/index.d.ts",
      "import": "./dist/db/adapter-core/index.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./workloads": {
      "types": "./dist/workloads/index.d.ts",
      "import": "./dist/workloads/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./server/adapters/node": {
      "types": "./dist/server/adapters/node.d.ts",
      "import": "./dist/server/adapters/node.js"
    },
    "./server/adapters/elysia": {
      "types": "./dist/server/adapters/elysia.d.ts",
      "import": "./dist/server/adapters/elysia.js"
    },
    "./server/adapters/express": {
      "types": "./dist/server/adapters/express.d.ts",
      "import": "./dist/server/adapters/express.js"
    },
    "./server/adapters/fastify": {
      "types": "./dist/server/adapters/fastify.d.ts",
      "import": "./dist/server/adapters/fastify.js"
    },
    "./server/adapters/h3": {
      "types": "./dist/server/adapters/h3.d.ts",
      "import": "./dist/server/adapters/h3.js"
    },
    "./server/adapters/hono": {
      "types": "./dist/server/adapters/hono.d.ts",
      "import": "./dist/server/adapters/hono.js"
    },
    "./server/adapters/nextjs-pages-router": {
      "types": "./dist/server/adapters/nextjs-pages-router.d.ts",
      "import": "./dist/server/adapters/nextjs-pages-router.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/services/zelavis-app"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.9.3",
    "elysia": "^1.4.29",
    "express": "^5.0.0",
    "fastify": "^5.9.0",
    "h3": "2.0.1-rc.22",
    "hono": "^4.12.34",
    "next": "16.2.11"
  },
  "keywords": [
    "zelavis",
    "app",
    "service",
    "backend"
  ]
}

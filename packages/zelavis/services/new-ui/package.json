{
  "name": "@zelavis/new-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Experimental Fuzor dashboard for Zelavis",
  "zelavis": {
    "kind": "frontend",
    "namespace": "newui",
    "frontend": {
      "runtime": "static",
      "bundle": ".fuzor/dist-spa-server/client",
      "mode": "spa",
      "assetBase": "/assets/"
    }
  },
  "exports": {
    ".": "./src/new-ui-service.ts",
    "./frontend": "./src/frontend.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare:local": "node scripts/link-local.mjs",
    "dev": "node scripts/dev.mjs",
    "build:fuzor": "node scripts/build.mjs",
    "typecheck:fuzor": "node scripts/typecheck.mjs",
    "test:fuzor": "node --test tests/*.test.mjs",
    "prepare:grids": "node scripts/prepare-grids.mjs",
    "test:server-views": "node scripts/test-server-views.mjs",
    "test:embedded-server-views": "node scripts/test-embedded-server-views.mjs",
    "test:dev-server-views": "node scripts/test-embedded-server-views.mjs --dev",
    "audit:routes": "node scripts/audit-routes.mjs --check",
    "test:route-parity": "node scripts/test-route-parity.mjs"
  },
  "localDevelopment": {
    "fuzor": "Sibling checkout at Projects/fuzor, built with its own dependencies",
    "effect": "Host-provided Zelavis Effect 4.0.0",
    "dependencies": "Isolated pinned grid-dependencies npm lockfile; local links reuse the existing dashboard React 19 runtime and dependencies without changing the parent workspace lockfile"
  }
}

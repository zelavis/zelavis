{
  "name": "@zelavis/ui",
  "version": "1.1.0-alpha.36",
  "private": false,
  "description": "The Zelavis dashboard, built with Fuzor and registered through the Zelavis SDK.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "zelavis": {
    "kind": "frontend",
    "namespace": "ui",
    "frontend": {
      "runtime": "static",
      "bundle": ".fuzor/web/dist-spa",
      "mode": "spa",
      "assetBase": "/assets/"
    }
  },
  "types": "./dist/dashboard-service.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dashboard-service.d.ts",
      "import": "./dist/dashboard-service.js"
    },
    "./service": {
      "types": "./dist/dashboard-service.d.ts",
      "import": "./dist/dashboard-service.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "import": "./dist/frontend.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    ".fuzor/web/dist-spa",
    ".fuzor/dist-backend",
    ".fuzor/fuzor-build.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/services/zelavis-ui"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs && pnpm run build:plugin",
    "dev": "node scripts/dev.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/audit-routes.mjs --check && node scripts/test-server-views.mjs && node scripts/test-route-parity.mjs && node scripts/test-embedded-server-views.mjs",
    "test:browser:dev": "node scripts/test-embedded-server-views.mjs --dev",
    "audit:routes": "node scripts/audit-routes.mjs --check",
    "build:plugin": "tsc -p tsconfig.plugin.json",
    "dev:server": "node scripts/dev-server.mjs"
  },
  "peerDependencies": {
    "zelavis": "workspace:*"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@glideapps/glide-data-grid": "6.0.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/tabulator-tables": "6.3.1",
    "@visactor/vtable": "1.26.8",
    "@visactor/vtable-editors": "1.26.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "effect": "4.0.0",
    "fuzor": "0.5.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "swiper": "^14.3.0",
    "tabulator-tables": "6.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.2.6"
  }
}

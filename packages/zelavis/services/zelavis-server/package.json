{
  "name": "@zelavis/server",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Unified endpoint contract and long-running Node host adapter for Zelavis server packages.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/services/server"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/zelavis/services/server#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "server",
    "endpoints",
    "node",
    "adapter"
  ]
}

{
  "name": "@zelavis/auth",
  "version": "1.1.0-alpha.25",
  "private": false,
  "description": "Auth settings page for the Zelavis dashboard, with a catalogue of installable auth plugins.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "plugin",
    "namespace": "auth",
    "capabilities": [
      "dashboard:menu"
    ],
    "marketplace": {
      "title": "Auth",
      "summary": "Configure sign-in and install auth providers.",
      "categories": [
        "auth"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dist",
    "dashboard"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/services/zelavis-auth"
  },
  "peerDependencies": {
    "zelavis": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": [
    "zelavis",
    "auth",
    "settings",
    "dashboard"
  ]
}

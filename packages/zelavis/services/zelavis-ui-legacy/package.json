{
  "name": "@zelavis/ui-legacy",
  "version": "1.1.0-alpha.36",
  "private": true,
  "description": "The React Router dashboard that preceded the Fuzor dashboard, kept as reference and as the source of the pages the Fuzor dashboard has not rebuilt natively yet. Not published and not loaded by the Platform.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/services/zelavis-ui-legacy"
  },
  "scripts": {
    "dev": "react-router dev --port 3000",
    "dev:mounted": "ZELAVIS_UI_BASE_PATH=/zelavis/ react-router dev --port 3000",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run --passWithNoTests --exclude 'tests/e2e/**' --exclude 'tests/setup-e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:mounted": "ZELAVIS_UI_BASE_PATH=/zelavis/ playwright test",
    "typecheck": "react-router typegen && tsc",
    "build:service-page-styles": "node scripts/generate-service-page-styles.mjs",
    "build:legacy": "node scripts/generate-service-page-styles.mjs && react-router build && node scripts/apply-runtime-base-path.mjs && node scripts/copy-dashboard-assets.mjs && tsc -p tsconfig.plugin.json"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.22",
    "@assistant-ui/react": "0.15.23",
    "@assistant-ui/react-markdown": "^0.14.18",
    "@assistant-ui/store": "0.3.16",
    "@base-ui/react": "^1.8.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/react": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@lexical/selection": "^0.52.0",
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "embla-carousel-react": "^8.6.0",
    "isbot": "^5.2.2",
    "lexical": "^0.52.0",
    "lucide-react": "^1.51.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "swiper": "^14.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.13",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "zelavis": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "zelavis": "workspace:*"
  }
}

{
  "name": "zelavis",
  "version": "2.0.0-alpha.25",
  "private": false,
  "description": "Open, self-hostable App Platform and embeddable backend framework.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "bin": {
    "zelavis": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/core/runtime/index.d.ts",
      "import": "./dist/core/runtime/index.js"
    },
    "./fabric": {
      "types": "./dist/core/fabric/index.d.ts",
      "import": "./dist/core/fabric/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "import": "./dist/edge/index.js"
    },
    "./edge/routes": {
      "types": "./dist/edge/routes.d.ts",
      "import": "./dist/edge/routes.js"
    },
    "./edge/traefik": {
      "types": "./dist/edge/traefik-compiler.d.ts",
      "import": "./dist/edge/traefik-compiler.js"
    },
    "./workload": {
      "types": "./dist/core/workload/index.d.ts",
      "import": "./dist/core/workload/index.js"
    },
    "./artifact": {
      "types": "./dist/core/artifact/index.d.ts",
      "import": "./dist/core/artifact/index.js"
    },
    "./provider": {
      "types": "./dist/core/provider/index.d.ts",
      "import": "./dist/core/provider/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./app/identity": {
      "types": "./dist/app/identity/index.d.ts",
      "import": "./dist/app/identity/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/node-sqlite": {
      "types": "./dist/db/engines/node-sqlite.d.ts",
      "import": "./dist/db/engines/node-sqlite.js"
    },
    "./db/node": {
      "types": "./dist/db/node-host.d.ts",
      "import": "./dist/db/node-host.js"
    },
    "./db/libsql": {
      "types": "./dist/db/engines/libsql.d.ts",
      "import": "./dist/db/engines/libsql.js"
    },
    "./db/lmdb": {
      "types": "./dist/db/engines/lmdb.d.ts",
      "import": "./dist/db/engines/lmdb.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./app/workloads": {
      "types": "./dist/app/workloads/index.d.ts",
      "import": "./dist/app/workloads/index.js"
    },
    "./backends": {
      "types": "./dist/backends/index.d.ts",
      "import": "./dist/backends/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "import": "./dist/adapters/bun.js"
    },
    "./adapters/project-runtime": {
      "types": "./dist/adapters/project-runtime.d.ts",
      "import": "./dist/adapters/project-runtime.js"
    },
    "./runtimes/node": {
      "types": "./dist/runtimes/node.d.ts",
      "import": "./dist/runtimes/node.js"
    },
    "./runtimes/bun": {
      "types": "./dist/runtimes/bun.d.ts",
      "import": "./dist/runtimes/bun.js"
    },
    "./runtimes/deno": {
      "types": "./dist/runtimes/deno.d.ts",
      "import": "./dist/runtimes/deno.js"
    },
    "./sdk": {
      "types": "./dist/sdk/fetch.d.ts",
      "import": "./dist/sdk/fetch.js"
    },
    "./sdk/browser": {
      "types": "./dist/sdk/browser.d.ts",
      "import": "./dist/sdk/browser.js"
    },
    "./sdk/node": {
      "types": "./dist/sdk/node.d.ts",
      "import": "./dist/sdk/node.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    },
    "./sdk/service-page": {
      "types": "./dist/sdk/service-page.d.ts",
      "import": "./dist/sdk/service-page.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./db/libsql-remote": {
      "types": "./dist/db/engines/libsql-remote.d.ts",
      "import": "./dist/db/engines/libsql-remote.js"
    },
    "./db/spatial": {
      "types": "./dist/db/spatial.d.ts",
      "import": "./dist/db/spatial.js"
    },
    "./recipe": {
      "types": "./dist/core/recipe/index.d.ts",
      "import": "./dist/core/recipe/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm run clean && pnpm run build:bootstrap && pnpm --filter @zelavis/marketplace build && pnpm --filter @zelavis/auth build && pnpm --filter @zelavis/app build && tsc -p tsconfig.json && node scripts/copy-installation-assets.mjs",
    "build:runtime": "pnpm run clean && pnpm run build:bootstrap && pnpm --filter @zelavis/marketplace build && pnpm --filter @zelavis/auth build && pnpm --filter @zelavis/app build && tsc -p tsconfig.json && node scripts/copy-installation-assets.mjs",
    "build:sdk": "pnpm run build:sdk:browser && pnpm run build:sdk:node",
    "build:sdk:browser": "tsc -p tsconfig.sdk.browser.json",
    "build:sdk:node": "tsc -p tsconfig.sdk.node.json",
    "typecheck": "pnpm run build:bootstrap && pnpm --filter @zelavis/marketplace build && pnpm --filter @zelavis/auth build && pnpm --filter @zelavis/app build && tsc -p tsconfig.json --noEmit && pnpm run diagnostics:effect",
    "diagnostics:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning,message",
    "test": "pnpm --filter @zelavis/ui build:plugin && pnpm run build && node --test test/*.test.mjs",
    "build:bootstrap": "tsc -p tsconfig.bootstrap.json",
    "bench": "node scripts/bench-engines.mjs",
    "bench:api": "node scripts/bench-api.mjs",
    "bench:cold": "node scripts/bench-cold.mjs",
    "bench:engines": "node scripts/bench-engines.mjs",
    "bench:ordered": "node scripts/bench-ordered.mjs",
    "bench:related": "node scripts/bench-related.mjs",
    "bench:scatter": "node scripts/bench-scatter.mjs",
    "bench:seal": "node scripts/bench-seal.mjs",
    "bench:timeseries": "node scripts/bench-timeseries.mjs"
  },
  "files": [
    "dist",
    "services/zelavis-app/package.json",
    "services/zelavis-auth/package.json",
    "services/zelavis-marketplace/package.json",
    "services/zelavis-ui/package.json",
    "services/zelavis-app/dist",
    "services/zelavis-auth/dist",
    "services/zelavis-auth/dashboard",
    "services/zelavis-marketplace/dist",
    "services/zelavis-marketplace/allowlist.snapshot.json",
    "services/zelavis-ui/dist",
    "services/zelavis-ui/build/client"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "effect": "4.0.0",
    "jose": "^6.2.12",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.3",
    "@effect/tsgo": "^0.47.2",
    "@harperfast/rocksdb-js": "2.9.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^26.6.4",
    "@zelavis/app": "workspace:*",
    "@zelavis/auth": "workspace:*",
    "@zelavis/marketplace": "workspace:*",
    "@zelavis/ui": "workspace:*",
    "h3-js": "^4.5.0",
    "libsql": "^0.5.29",
    "lmdb": "^3.4.3",
    "typescript": "^7.0.2",
    "usearch": "^2.26.2"
  },
  "keywords": [
    "zelavis",
    "runtime",
    "services",
    "database"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@harperfast/rocksdb-js": "^2.9.1",
    "@libsql/client": "^0.15.0",
    "h3-js": "^4.5.0",
    "libsql": "^0.5.29",
    "lmdb": "^3.4.3",
    "usearch": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "libsql": {
      "optional": true
    },
    "@harperfast/rocksdb-js": {
      "optional": true
    },
    "lmdb": {
      "optional": true
    },
    "@libsql/client": {
      "optional": true
    },
    "h3-js": {
      "optional": true
    },
    "usearch": {
      "optional": true
    }
  }
}

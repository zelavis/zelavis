{
  "name": "zelavis",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Composable Zelavis runtime with core services included by default.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "import": "./dist/adapters/bun.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "import": "./dist/adapters/cloudflare.js"
    },
    "./adapters/vercel": {
      "types": "./dist/adapters/vercel.d.ts",
      "import": "./dist/adapters/vercel.js"
    },
    "./adapters/netlify": {
      "types": "./dist/adapters/netlify.d.ts",
      "import": "./dist/adapters/netlify.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "import": "./dist/fastify/index.js"
    },
    "./h3": {
      "types": "./dist/h3/index.d.ts",
      "import": "./dist/h3/index.js"
    },
    "./elysia": {
      "types": "./dist/elysia/index.d.ts",
      "import": "./dist/elysia/index.js"
    },
    "./nextjs/pages": {
      "types": "./dist/nextjs/pages/index.d.ts",
      "import": "./dist/nextjs/pages/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @zelavis/server build && pnpm --filter @zelavis/db build && pnpm --filter @zelavis/auth build && pnpm --filter @zelavis/ui build && tsc -p tsconfig.json",
    "build:runtime": "pnpm --filter @zelavis/ui build:plugin && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @zelavis/ui build:plugin && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm --filter @zelavis/ecommerce build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/auth": "workspace:*",
    "@zelavis/db": "workspace:*",
    "@zelavis/db-bun-sqlite": "workspace:*",
    "@zelavis/db-cloudflare-d1": "workspace:*",
    "@zelavis/db-node-sqlite": "workspace:*",
    "@zelavis/server": "workspace:*",
    "@zelavis/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "elysia": "^1.4.29",
    "fastify": "^5.9.0",
    "h3": "2.0.1-rc.22",
    "hono": "^4.12.27",
    "next": "16.2.11",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zelavis",
    "runtime",
    "services",
    "database"
  ]
}

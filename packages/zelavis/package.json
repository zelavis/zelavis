{
  "name": "zelavis",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Open, self-hostable App Platform and embeddable backend framework.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "bin": {
    "zelavis": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/core/runtime/index.d.ts",
      "import": "./dist/core/runtime/index.js"
    },
    "./fabric": {
      "types": "./dist/core/fabric/index.d.ts",
      "import": "./dist/core/fabric/index.js"
    },
    "./workload": {
      "types": "./dist/core/workload/index.d.ts",
      "import": "./dist/core/workload/index.js"
    },
    "./artifact": {
      "types": "./dist/core/artifact/index.d.ts",
      "import": "./dist/core/artifact/index.js"
    },
    "./provider": {
      "types": "./dist/core/provider/index.d.ts",
      "import": "./dist/core/provider/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./app/auth": {
      "types": "./dist/app/auth/index.d.ts",
      "import": "./dist/app/auth/index.js"
    },
    "./db": {
      "types": "./dist/db/index.d.ts",
      "import": "./dist/db/index.js"
    },
    "./db/node-sqlite": {
      "types": "./dist/db/engines/node-sqlite.d.ts",
      "import": "./dist/db/engines/node-sqlite.js"
    },
    "./db/node": {
      "types": "./dist/db/node-host.d.ts",
      "import": "./dist/db/node-host.js"
    },
    "./db/libsql": {
      "types": "./dist/db/engines/libsql.d.ts",
      "import": "./dist/db/engines/libsql.js"
    },
    "./db/rocksdb": {
      "types": "./dist/db/engines/rocksdb.d.ts",
      "import": "./dist/db/engines/rocksdb.js"
    },
    "./db/lmdb": {
      "types": "./dist/db/engines/lmdb.d.ts",
      "import": "./dist/db/engines/lmdb.js"
    },
    "./db/schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./app/workloads": {
      "types": "./dist/app/workloads/index.d.ts",
      "import": "./dist/app/workloads/index.js"
    },
    "./wordpress": {
      "types": "./dist/wordpress/index.d.ts",
      "import": "./dist/wordpress/index.js"
    },
    "./backends": {
      "types": "./dist/backends/index.d.ts",
      "import": "./dist/backends/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "import": "./dist/adapters/bun.js"
    },
    "./runtimes/node": {
      "types": "./dist/runtimes/node.d.ts",
      "import": "./dist/runtimes/node.js"
    },
    "./runtimes/bun": {
      "types": "./dist/runtimes/bun.d.ts",
      "import": "./dist/runtimes/bun.js"
    },
    "./runtimes/deno": {
      "types": "./dist/runtimes/deno.d.ts",
      "import": "./dist/runtimes/deno.js"
    },
    "./sdk": {
      "types": "./dist/sdk/fetch.d.ts",
      "import": "./dist/sdk/fetch.js"
    },
    "./sdk/browser": {
      "types": "./dist/sdk/browser.d.ts",
      "import": "./dist/sdk/browser.js"
    },
    "./sdk/node": {
      "types": "./dist/sdk/node.d.ts",
      "import": "./dist/sdk/node.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    },
    "./sdk/service-page": {
      "types": "./dist/sdk/service-page.d.ts",
      "import": "./dist/sdk/service-page.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm run clean && pnpm run build:bootstrap && pnpm --filter @zelavis/marketplace build && pnpm --filter @zelavis/auth build && tsc -p tsconfig.json",
    "build:runtime": "pnpm run clean && pnpm run build:bootstrap && pnpm --filter @zelavis/marketplace build && pnpm --filter @zelavis/auth build && tsc -p tsconfig.json",
    "build:sdk": "pnpm run build:sdk:browser && pnpm run build:sdk:node",
    "build:sdk:browser": "tsc -p tsconfig.sdk.browser.json",
    "build:sdk:node": "tsc -p tsconfig.sdk.node.json",
    "typecheck": "pnpm run build:bootstrap && pnpm --filter @zelavis/marketplace build && pnpm --filter @zelavis/auth build && tsc -p tsconfig.json --noEmit && pnpm run diagnostics:effect",
    "diagnostics:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --severity error,warning,message",
    "test": "pnpm --filter @zelavis/ui build:plugin && pnpm run build && node --test test/*.test.mjs",
    "update:wordpress": "node scripts/update-wordpress-release.mjs",
    "build:bootstrap": "tsc -p tsconfig.bootstrap.json"
  },
  "files": [
    "dist",
    "services"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/auth": "workspace:*",
    "@zelavis/marketplace": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "effect": "4.0.0-rc.112",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "^0.43.0",
    "@harperfast/rocksdb-js": "2.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.4.0",
    "libsql": "^0.5.29",
    "lmdb": "^3.4.3",
    "rocksdb": "^5.2.1",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "zelavis",
    "runtime",
    "services",
    "database"
  ],
  "engines": {
    "node": ">=24"
  },
  "optionalDependencies": {
    "@zelavis/ui": "workspace:*"
  },
  "peerDependencies": {
    "libsql": "^0.5.29",
    "lmdb": "^3.4.3",
    "rocksdb": "^5.2.1"
  },
  "peerDependenciesMeta": {
    "libsql": {
      "optional": true
    },
    "rocksdb": {
      "optional": true
    },
    "lmdb": {
      "optional": true
    }
  }
}

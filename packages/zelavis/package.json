{
  "name": "zelavis",
  "version": "1.0.1-alpha.1",
  "private": false,
  "description": "Composable Zelavis runtime with core services included by default.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./integrations/elysia": {
      "types": "./dist/integrations/elysia.d.ts",
      "import": "./dist/integrations/elysia.js"
    },
    "./integrations/express": {
      "types": "./dist/integrations/express.d.ts",
      "import": "./dist/integrations/express.js"
    },
    "./integrations/fastify": {
      "types": "./dist/integrations/fastify.d.ts",
      "import": "./dist/integrations/fastify.js"
    },
    "./integrations/hono": {
      "types": "./dist/integrations/hono.d.ts",
      "import": "./dist/integrations/hono.js"
    },
    "./integrations/h3": {
      "types": "./dist/integrations/h3.d.ts",
      "import": "./dist/integrations/h3.js"
    },
    "./integrations/nextjs-pages-router": {
      "types": "./dist/integrations/nextjs-pages-router.d.ts",
      "import": "./dist/integrations/nextjs-pages-router.js"
    },
    "./integrations/node": {
      "types": "./dist/integrations/node.d.ts",
      "import": "./dist/integrations/node.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @zelavis/ui build && node scripts/copy-dashboard.mjs && tsc -p tsconfig.json",
    "build:runtime": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/auth": "workspace:*",
    "@zelavis/database": "workspace:*",
    "@zelavis/server": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zelavis",
    "runtime",
    "services",
    "database"
  ]
}

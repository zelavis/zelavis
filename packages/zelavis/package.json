{
  "name": "zelavis",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Self-hostable Zelavis Platform OS runtime and control plane.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "bin": {
    "zelavis": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./service": {
      "types": "./dist/service.d.ts",
      "import": "./dist/service.js"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "import": "./dist/adapters/bun.js"
    },
    "./runtimes/node": {
      "types": "./dist/runtimes/node.d.ts",
      "import": "./dist/runtimes/node.js"
    },
    "./runtimes/bun": {
      "types": "./dist/runtimes/bun.d.ts",
      "import": "./dist/runtimes/bun.js"
    },
    "./runtimes/deno": {
      "types": "./dist/runtimes/deno.d.ts",
      "import": "./dist/runtimes/deno.js"
    },
    "./sdk": {
      "types": "./dist/sdk/fetch.d.ts",
      "import": "./dist/sdk/fetch.js"
    },
    "./sdk/browser": {
      "types": "./dist/sdk/browser.d.ts",
      "import": "./dist/sdk/browser.js"
    },
    "./sdk/node": {
      "types": "./dist/sdk/node.d.ts",
      "import": "./dist/sdk/node.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "pnpm run clean && pnpm --filter @zelavis/server build && pnpm --filter @zelavis/app build && pnpm --filter @zelavis/app-db-node-sqlite build && pnpm --filter @zelavis/ui build && pnpm --filter @zelavis/cli build && tsc -p tsconfig.json",
    "build:runtime": "pnpm run clean && pnpm --filter @zelavis/app build && pnpm --filter @zelavis/app-db-node-sqlite build && pnpm --filter @zelavis/ui build:plugin && pnpm --filter @zelavis/cli build && tsc -p tsconfig.json",
    "build:sdk": "pnpm run build:sdk:browser && pnpm run build:sdk:node",
    "build:sdk:browser": "pnpm --filter @zelavis/app build && tsc -p tsconfig.sdk.browser.json",
    "build:sdk:node": "pnpm --filter @zelavis/app build && tsc -p tsconfig.sdk.node.json",
    "typecheck": "pnpm --filter @zelavis/app build && pnpm --filter @zelavis/app-db-node-sqlite build && pnpm --filter @zelavis/ui build:plugin && pnpm --filter @zelavis/cli build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm --filter @zelavis/ecommerce build && node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "services"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/app": "workspace:*",
    "@zelavis/cli": "workspace:*",
    "@zelavis/server": "workspace:*",
    "@zelavis/ui": "workspace:*",
    "better-sqlite3": "^12.10.0",
    "@zelavis/app-db-node-sqlite": "workspace:*",
    "@zelavis/app-db-bun-sqlite": "workspace:*",
    "effect": "4.0.0-rc.111"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zelavis",
    "runtime",
    "services",
    "database"
  ],
  "engines": {
    "node": ">=24"
  }
}

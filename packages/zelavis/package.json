{
  "name": "zelavis",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Composable Zelavis runtime with core services included by default.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js"
    },
    "./adapters/elysia": {
      "types": "./dist/adapters/elysia.d.ts",
      "import": "./dist/adapters/elysia.js"
    },
    "./adapters/express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./adapters/fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    },
    "./adapters/hono": {
      "types": "./dist/adapters/hono.d.ts",
      "import": "./dist/adapters/hono.js"
    },
    "./adapters/h3": {
      "types": "./dist/adapters/h3.d.ts",
      "import": "./dist/adapters/h3.js"
    },
    "./adapters/nextjs-pages-router": {
      "types": "./dist/adapters/nextjs-pages-router.d.ts",
      "import": "./dist/adapters/nextjs-pages-router.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "import": "./dist/adapters/node.js"
    },
    "./platforms/node": {
      "types": "./dist/platforms/node.d.ts",
      "import": "./dist/platforms/node.js"
    },
    "./platforms/bun": {
      "types": "./dist/platforms/bun.d.ts",
      "import": "./dist/platforms/bun.js"
    },
    "./platforms/cloudflare": {
      "types": "./dist/platforms/cloudflare.d.ts",
      "import": "./dist/platforms/cloudflare.js"
    },
    "./platforms/netlify": {
      "types": "./dist/platforms/netlify.d.ts",
      "import": "./dist/platforms/netlify.js"
    },
    "./platforms/vercel": {
      "types": "./dist/platforms/vercel.d.ts",
      "import": "./dist/platforms/vercel.js"
    },
    "./storage/s3": {
      "types": "./dist/storage/s3.d.ts",
      "import": "./dist/storage/s3.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @zelavis/server build && pnpm --filter @zelavis/database build && pnpm --filter @zelavis/auth build && pnpm --filter @zelavis/ui build && node scripts/copy-dashboard.mjs && tsc -p tsconfig.json",
    "build:runtime": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && pnpm --filter @zelavis/plugin-ecommerce build && node --test test/*.test.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/auth": "workspace:*",
    "@zelavis/database": "workspace:*",
    "@zelavis/database-bun-sqlite": "workspace:*",
    "@zelavis/database-cloudflare-d1": "workspace:*",
    "@zelavis/database-node-sqlite": "workspace:*",
    "@zelavis/plugin-ecommerce": "workspace:*",
    "@zelavis/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "elysia": "^1.4.28",
    "fastify": "^5.6.1",
    "h3": "2.0.1-rc.21",
    "hono": "^4.12.16",
    "next": "16.2.4",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "zelavis",
    "runtime",
    "services",
    "database"
  ]
}

{
  "name": "@zelavis/ui",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Zelavis dashboard SPA packaged as a system plugin.",
  "license": "MIT",
  "author": "Ivan Jeremic",
  "type": "module",
  "zelavis": {
    "kind": "frontend",
    "frontend": {
      "runtime": "static",
      "bundle": "build/client",
      "mode": "spa",
      "assetBase": "/assets/",
      "basePathGlobal": "__ZELAVIS_BASE_PATH__"
    }
  },
  "main": "./dist/dashboard-service.js",
  "types": "./dist/dashboard-service.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dashboard-service.d.ts",
      "import": "./dist/dashboard-service.js"
    },
    "./service": {
      "types": "./dist/dashboard-service.d.ts",
      "import": "./dist/dashboard-service.js"
    },
    "./service-page-styles": {
      "types": "./dist/generated/service-page-styles.d.ts",
      "import": "./dist/generated/service-page-styles.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "import": "./dist/frontend.js"
    },
    "./dashboard-assets": {
      "types": "./dist/generated/dashboard-assets.d.ts",
      "import": "./dist/generated/dashboard-assets.js"
    }
  },
  "files": [
    "dist",
    "build/client"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/product-services/zelavis-ui"
  },
  "homepage": "https://www.zelavis.com",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "scripts": {
    "build": "node scripts/generate-service-page-styles.mjs && react-router build && node scripts/apply-runtime-base-path.mjs && node scripts/copy-dashboard-assets.mjs && tsc -p tsconfig.plugin.json",
    "build:plugin": "node scripts/generate-service-page-styles.mjs && tsc -p tsconfig.plugin.json",
    "dev": "react-router dev --port 3000",
    "dev:mounted": "ZELAVIS_UI_BASE_PATH=/zelavis/ react-router dev --port 3000",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run --passWithNoTests --exclude 'tests/e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:mounted": "ZELAVIS_UI_BASE_PATH=/zelavis/ playwright test",
    "typecheck": "react-router typegen && tsc && tsc -p tsconfig.plugin.json --noEmit",
    "build:service-page-styles": "node scripts/generate-service-page-styles.mjs"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.16",
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "^0.14.14",
    "@assistant-ui/store": "0.3.12",
    "@base-ui/react": "^1.7.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@glideapps/glide-data-grid": "^6.0.3",
    "@lexical/history": "^0.50.0",
    "@lexical/html": "^0.49.0",
    "@lexical/link": "^0.49.0",
    "@lexical/list": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.49.0",
    "@lexical/selection": "^0.50.0",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "embla-carousel-react": "^8.6.0",
    "isbot": "^5.2.2",
    "lexical": "^0.49.0",
    "lucide-react": "^1.40.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "swiper": "^14.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jsdom": "^28.1.0",
    "shadcn": "^4.20.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.0.16",
    "vitest": "^4.1.9",
    "zelavis": "workspace:*"
  }
}

{
  "name": "@zelavis/auth",
  "version": "1.0.1-alpha.2",
  "private": false,
  "description": "Auth settings page for the Zelavis dashboard, with a catalogue of installable auth plugins.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "zelavis": {
    "kind": "plugin"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/zelavis/product-services/zelavis-auth"
  },
  "peerDependencies": {
    "zelavis": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "keywords": [
    "zelavis",
    "auth",
    "settings",
    "dashboard"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "plugins": [
      {
        "name": "@effect/language-service"
      }
    ],
    // Enabled so dead helpers cannot accumulate. `noUnusedParameters` is
    // deliberately not enabled: `ZelavisServerFetchHandler<TService>` carries a
    // public generic that callers supply even though the declaration body does
    // not reference it.
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"]
}

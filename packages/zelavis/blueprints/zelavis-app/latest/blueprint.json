{
  "schemaVersion": 1,
  "id": "zelavis/app",
  "name": "Zelavis App",
  "version": "1.0.1-alpha.2",
  "kind": "zelavis-app",
  "description": "The official Zelavis application backend with database, application auth, storage, and workloads services.",
  "source": "official",
  "status": "development",
  "runtime": {
    "type": "javascript",
    "engines": ["node", "bun", "deno"]
  },
  "services": [
    { "package": "@zelavis/db", "version": "1.0.1-alpha.2", "required": true },
    { "package": "@zelavis/auth", "version": "1.0.1-alpha.2", "required": true },
    { "package": "@zelavis/storage", "version": "1.0.1-alpha.2", "required": true },
    { "package": "@zelavis/workloads", "version": "1.0.1-alpha.2", "required": false }
  ],
  "metadata": {
    "projectType": "zelavis",
    "bundled": true
  }
}

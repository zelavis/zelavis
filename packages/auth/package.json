  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zelavis/zelavis.git",
    "directory": "packages/auth"
  },
  "homepage": "https://github.com/zelavis/zelavis/tree/main/packages/auth#readme",
  "bugs": {
    "url": "https://github.com/zelavis/zelavis/issues"
  },
  "dependencies": {
    "@zelavis/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "auth",
    "authentication",
    "credentials",
    "sessions",
    "plugins"
  ]

{
  "name": "@zelavis/auth",
  "version": "1.0.0",
  "private": true,
  "description": "Low-level authentication primitives for building custom auth systems and integrations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zelavis/server": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "auth",
    "authentication",
    "credentials",
    "sessions",
    "plugins"
  ]
}

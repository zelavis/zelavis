{
  "name": "@zelavis/auth-email-password",
  "version": "1.0.0",
  "private": true,
  "description": "Email/password plugin for @zelavis/auth.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zelavis/auth": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "auth",
    "email",
    "password",
    "plugin"
  ]
}

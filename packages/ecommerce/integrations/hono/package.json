{
  "name": "@zelavis/ecommerce-hono",
  "version": "1.0.0",
  "private": true,
  "description": "Hono integration for @zelavis/ecommerce.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zelavis/ecommerce": "workspace:*"
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "devDependencies": {
    "hono": "^4.0.0",
    "typescript": "^5.9.0"
  },
  "keywords": [
    "hono",
    "commerce",
    "ecommerce",
    "integration"
  ]
}

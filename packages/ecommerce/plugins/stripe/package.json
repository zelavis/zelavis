{
  "name": "@zelavis/ecommerce-stripe",
  "version": "1.0.0",
  "private": true,
  "description": "Stripe payment provider plugin for @zelavis/ecommerce.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@zelavis/ecommerce": "workspace:*",
    "stripe": "^20.4.0"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "keywords": [
    "stripe",
    "commerce",
    "ecommerce",
    "payments",
    "plugin"
  ]
}
